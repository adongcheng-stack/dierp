# ─────────────────────────────────────────────────────────────
# 组织架构与系统管理 overlay（admin.yaml）
# ─────────────────────────────────────────────────────────────
:Department a owl:Class ; rdfs:subClassOf :Agent ; rdfs:label "部门" ;
    rdfs:comment "组织架构节点，可自引用形成树；归属上层为 :PhysicalObject 之外的行动主体范畴。" .
:Menu a owl:Class ; rdfs:subClassOf :NormativeRule ; rdfs:label "系统菜单" ;
    rdfs:comment "前端路由与按钮权限的声明，角色通过 RoleMenu 授权。" .
:RoleMenu a owl:Class ; rdfs:subClassOf :NormativeRule ; rdfs:label "角色菜单授权" .
:SystemParameter a owl:Class ; rdfs:subClassOf :NormativeRule ; rdfs:label "系统参数" .
:LoginLog a owl:Class ; rdfs:subClassOf :EventRecord ; rdfs:label "登录日志" .

:departmentType a owl:DatatypeProperty ; rdfs:range xsd:string .
:menuType a owl:DatatypeProperty ; rdfs:range xsd:string .
:paramType a owl:DatatypeProperty ; rdfs:range xsd:string .
:loginStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
:parentDepartment a owl:ObjectProperty ; rdfs:range :Department .
:parentMenu a owl:ObjectProperty ; rdfs:range :Menu .
:grantedRole a owl:ObjectProperty ; rdfs:range :Role .
:grantedMenu a owl:ObjectProperty ; rdfs:range :Menu .

# ─────────────────────────────────────────────────────────────
# 驾驶舱 overlay（dashboard.yaml）
# ─────────────────────────────────────────────────────────────
:DashboardRule a owl:Class ; rdfs:subClassOf :NormativeRule ; rdfs:label "驾驶舱预警规则" .
:dashboardScope a owl:DatatypeProperty ; rdfs:range xsd:string .
:operator a owl:DatatypeProperty ; rdfs:range xsd:string .
:threshold a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:defaultWindow a owl:DatatypeProperty ; rdfs:range xsd:string .
:scope a owl:DatatypeProperty ; rdfs:range xsd:string .
:level a owl:DatatypeProperty ; rdfs:range xsd:string .
:menuId a owl:DatatypeProperty ; rdfs:range xsd:integer .

# ─────────────────────────────────────────────────────────────
# 业财 / 库存估值闭环 overlay（planning.yaml：S51-S52）
# 顶层范畴严格取 planning.yaml 的 top_category，保证运营模型与本体同构。
# ─────────────────────────────────────────────────────────────
:Account a owl:Class ; rdfs:subClassOf :Document ; rdfs:label "会计科目" .
:JournalEntry a owl:Class ; rdfs:subClassOf :Document ; rdfs:label "记账凭证" .
:JournalLine a owl:Class ; rdfs:subClassOf :DocumentLine ; rdfs:label "分录行" .
:FiscalPeriod a owl:Class ; rdfs:subClassOf :Document ; rdfs:label "会计期间" .
:InventoryValuation a owl:Class ; rdfs:subClassOf :EventRecord ; rdfs:label "库存估值" .
:ValuationMove a owl:Class ; rdfs:subClassOf :EventRecord ; rdfs:label "估值流水" .

:accountCode a owl:DatatypeProperty ; rdfs:range xsd:string .
:accountName a owl:DatatypeProperty ; rdfs:range xsd:string .
:accountType a owl:DatatypeProperty ; rdfs:range xsd:string .
:parentCode a owl:DatatypeProperty ; rdfs:range xsd:string .
:isLeaf a owl:DatatypeProperty ; rdfs:range xsd:boolean .
:periodCode a owl:DatatypeProperty ; rdfs:range xsd:string .
:journalStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
:glSourceType a owl:DatatypeProperty ; rdfs:range xsd:string .
:debit a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:credit a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:summary a owl:DatatypeProperty ; rdfs:range xsd:string .
:endDate a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
:periodStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
:qty a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:avgCost a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:lastCost a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:moveNumber a owl:DatatypeProperty ; rdfs:range xsd:string .
:direction a owl:DatatypeProperty ; rdfs:range xsd:string .
:balanceQty a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:balanceAmount a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:costSourceType a owl:DatatypeProperty ; rdfs:range xsd:string .
:reversalOf a owl:DatatypeProperty ; rdfs:range xsd:string .

# ─────────────────────────────────────────────────────────────
# MES 跨库只读侧（mes-mapping.yaml）
# MES 是独立事实源：使用独立类与属性承载工单/工序/报工，不复用 ERP 的
# ProductionOrder 编号形状（ERP 为 PO-YYYYMMDD-XXXX，MES 为 GD-YYYYMMDD-NNNNN）。
# ─────────────────────────────────────────────────────────────
:MesWorkOrder a owl:Class ; rdfs:subClassOf :Document ; rdfs:label "MES 工单" .
:MesProcessTask a owl:Class ; rdfs:subClassOf :DocumentLine ; rdfs:label "MES 工序任务" .
:MesProcessReport a owl:Class ; rdfs:subClassOf :EventRecord ; rdfs:label "MES 报工记录" .

:mesWorkOrderNo a owl:DatatypeProperty ; rdfs:range xsd:string .
:mesProductName a owl:DatatypeProperty ; rdfs:range xsd:string .
:mesOrderStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
:mesOrderQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:mesOrderCompletedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:mesOrderQualifiedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:mesOrderScrappedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:mesPlannedStart a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
:mesPlannedEnd a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
:mesTaskId a owl:DatatypeProperty ; rdfs:range xsd:integer .
:mesTaskSequence a owl:DatatypeProperty ; rdfs:range xsd:integer .
:mesTaskStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
:mesEquipmentId a owl:DatatypeProperty ; rdfs:range xsd:integer .
:mesTaskCompletedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:mesTaskQualifiedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:mesTaskScrappedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:mesReportId a owl:DatatypeProperty ; rdfs:range xsd:integer .
:mesReportTime a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
:mesReportCompletedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:mesReportQualifiedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:mesReportScrappedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal .
:mesDefectReason a owl:DatatypeProperty ; rdfs:range xsd:string .
:mesActualHours a owl:DatatypeProperty ; rdfs:range xsd:decimal .

:belongsToMesWorkOrder a owl:ObjectProperty ;
    rdfs:domain :MesProcessTask ; rdfs:range :MesWorkOrder .
:reportsMesTask a owl:ObjectProperty ;
    rdfs:domain :MesProcessReport ; rdfs:range :MesProcessTask .
