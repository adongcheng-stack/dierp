@prefix : <https://dierp.local/ontology/erp/v1#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ═══════════════════════════════════════════════════════════════
# SHACL 是业务铁律的权威实现。编号与 README 铁律对照表一致。
# ═══════════════════════════════════════════════════════════════

# S1 物料编码与类型
:MaterialShape a sh:NodeShape ;
    sh:targetClass :Material ;
    sh:property [
        sh:path :materialCode ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[A-Z0-9][A-Z0-9._-]{2,49}$" ;
        sh:message "S1 物料编码必填且只能包含大写字母、数字、点、下划线、连字符"
    ] ;
    sh:property [
        sh:path :materialType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "FG" "SEMI" "RAW" "PACKAGING" "SERVICE" ) ;
        sh:message "S1 物料类型必须来自 MaterialType 枚举"
    ] ;
    sh:property [
        sh:path :procurementType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "MAKE" "BUY" "SUB" ) ;
        sh:message "S1 采购类型必须来自 ProcurementType 枚举"
    ] .

# S2 计划参数策略
:PlanningPolicyShape a sh:NodeShape ;
    sh:targetClass :PlanningPolicy ;
    sh:property [
        sh:path :materialCode ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S2 计划参数必须绑定物料"
    ] ;
    sh:property [
        sh:path :lotSizingRule ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "LOT_FOR_LOT" "FIXED_LOT" "MIN_MAX" "EOQ" "PERIOD_ORDER" ) ;
        sh:message "S2 批量规则必须来自 LotSizingRule 枚举"
    ] ;
    sh:property [
        sh:path :mrpType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "MRP" "REORDER_POINT" "NONE" ) ;
        sh:message "S2 MRP 类型必须来自 MrpType 枚举"
    ] ;
    sh:property [
        sh:path :leadTimeDays ; sh:minInclusive 0 ;
        sh:message "S2 提前期不能为负"
    ] ;
    sh:property [
        sh:path :safetyStock ; sh:minInclusive 0 ;
        sh:message "S2 安全库存不能为负"
    ] ;
    sh:property [
        sh:path :minOrderQty ; sh:minInclusive 0 ;
        sh:message "S2 最小起订量不能为负"
    ] ;
    sh:property [
        sh:path :orderMultiple ; sh:minExclusive 0 ;
        sh:message "S2 整数倍必须大于 0"
    ] .

# S3 销售订单
:SalesOrderShape a sh:NodeShape ;
    sh:targetClass :SalesOrder ;
    sh:property [
        sh:path :documentNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^SO-[0-9]{8}-[0-9]{4}$" ;
        sh:message "S3 销售订单号必须符合 SO-YYYYMMDD-XXXX"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "DRAFT" "PENDING_REVIEW" "REVIEWING" "APPROVED" "REJECTED" "IN_PRODUCTION" "COMPLETED" "SHIPPED" "DELIVERED" "RECONCILED" "CLOSED" "CANCELLED" ) ;
        sh:message "S3 销售订单状态必须来自 SalesOrderStatus 枚举"
    ] ;
    sh:property [
        sh:path :quantity ; sh:minCount 1 ; sh:minExclusive 0 ;
        sh:message "S3 销售数量必须大于 0"
    ] ;
    sh:property [
        sh:path :dueDate ; sh:minCount 1 ;
        sh:message "S3 销售订单必须有交付日期"
    ] .

# S4 预测
:ForecastShape a sh:NodeShape ;
    sh:targetClass :Forecast ;
    sh:property [
        sh:path :documentNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^FC-[0-9]{8}-[0-9]{4}$" ;
        sh:message "S4 预测单号必须符合 FC-YYYYMMDD-XXXX"
    ] ;
    sh:property [
        sh:path :quantity ; sh:minCount 1 ; sh:minExclusive 0 ;
        sh:message "S4 预测数量必须大于 0"
    ] ;
    sh:property [
        sh:path :dueDate ; sh:minCount 1 ;
        sh:message "S4 预测必须有需求日期"
    ] .

# S5 MPS 主计划
:MpsPlanShape a sh:NodeShape ;
    sh:targetClass :MpsPlan ;
    sh:property [
        sh:path :documentNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^MPS-[0-9]{8}-[0-9]{3}$" ;
        sh:message "S5 MPS 单号必须符合 MPS-YYYYMMDD-NNN"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "DRAFT" "RELEASED" "CLOSED" "CANCELLED" ) ;
        sh:message "S5 MPS 状态必须来自 MpsPlanStatus 枚举"
    ] ;
    sh:property [
        sh:path :horizonStart ; sh:minCount 1 ;
        sh:message "S5 MPS 必须有计划开始日期"
    ] ;
    sh:property [
        sh:path :horizonEnd ; sh:minCount 1 ;
        sh:message "S5 MPS 必须有计划结束日期"
    ] .

# S6 MPS 计划行
:MpsEntryShape a sh:NodeShape ;
    sh:targetClass :MpsEntry ;
    sh:property [
        sh:path :materialCode ; sh:minCount 1 ;
        sh:message "S6 MPS 行必须指定物料"
    ] ;
    sh:property [
        sh:path :bucketDate ; sh:minCount 1 ;
        sh:message "S6 MPS 行必须有计划桶日期"
    ] ;
    sh:property [
        sh:path :grossRequirement ; sh:minCount 1 ; sh:minInclusive 0 ;
        sh:message "S6 毛需求不能为负"
    ] ;
    sh:property [
        sh:path :netRequirement ; sh:minCount 1 ; sh:minInclusive 0 ;
        sh:message "S6 净需求不能为负"
    ] ;
    sh:property [
        sh:path :plannerAction ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "NONE" "RELEASE" "EXPEDITE" "DELAY" "CANCEL" ) ;
        sh:message "S6 计划员行动必须来自 PlannerAction 枚举"
    ] .

# S7 MRP 运算批次
:MrpRunShape a sh:NodeShape ;
    sh:targetClass :MrpRun ;
    sh:property [
        sh:path :documentNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^MRP-[0-9]{8}-[0-9]{3}$" ;
        sh:message "S7 MRP 批次号必须符合 MRP-YYYYMMDD-NNN"
    ] ;
    sh:property [
        sh:path :runType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "REGENERATIVE" "NET_CHANGE" ) ;
        sh:message "S7 运算类型必须来自 MrpRunType 枚举"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "RUNNING" "COMPLETED" "FAILED" ) ;
        sh:message "S7 运算状态必须来自 MrpRunStatus 枚举"
    ] ;
    sh:property [
        sh:path :horizonStart ; sh:minCount 1 ;
        sh:message "S7 MRP 必须有计划开始日期"
    ] ;
    sh:property [
        sh:path :horizonEnd ; sh:minCount 1 ;
        sh:message "S7 MRP 必须有计划结束日期"
    ] .

# S8 计划订单 + 图级 BOM 存在性
:PlannedOrderShape a sh:NodeShape ;
    sh:targetClass :PlannedOrder ;
    sh:property [
        sh:path :documentNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^PLO-[0-9]{8}-[0-9]{4}$" ;
        sh:message "S8 计划订单号必须符合 PLO-YYYYMMDD-XXXX"
    ] ;
    sh:property [
        sh:path :orderType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "PRODUCTION" "PURCHASE" "TRANSFER" ) ;
        sh:message "S8 计划订单类型必须来自 PlannedOrderType 枚举"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "PLANNED" "FIRMED" "RELEASED" "CANCELLED" ) ;
        sh:message "S8 计划订单状态必须来自 PlannedOrderStatus 枚举"
    ] ;
    sh:property [
        sh:path :quantity ; sh:minCount 1 ; sh:minExclusive 0 ;
        sh:message "S8 计划订单数量必须大于 0"
    ] ;
    sh:property [
        sh:path :startDate ; sh:minCount 1 ;
        sh:message "S8 计划订单必须有开始日期"
    ] ;
    sh:property [
        sh:path :dueDate ; sh:minCount 1 ;
        sh:message "S8 计划订单必须有完工/到货日期"
    ] ;
    sh:sparql [
        sh:message "S8 生产型计划订单的物料必须存在已发布 BOM" ;
        sh:select """
            PREFIX : <https://dierp.local/ontology/erp/v1#>
            SELECT $this ?value WHERE {
                $this :orderType "PRODUCTION" ;
                      :materialCode ?value .
                FILTER NOT EXISTS {
                    ?bom a :BOM ;
                         :parentMaterialCode ?value ;
                         :status "RELEASED" .
                }
            }
        """
    ] .

# S9 MRP 异常
:MrpExceptionShape a sh:NodeShape ;
    sh:targetClass :MrpException ;
    sh:property [
        sh:path :exceptionType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "SHORTAGE" "EXCESS" "LATE" "EARLY" "NO_BOM" "NO_POLICY" "LEAD_TIME_VIOLATION" "CAPACITY_OVERLOAD" ) ;
        sh:message "S9 异常类型必须来自 MrpExceptionType 枚举"
    ] ;
    sh:property [
        sh:path :severity ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "INFO" "WARNING" "CRITICAL" ) ;
        sh:message "S9 异常级别必须来自 ExceptionSeverity 枚举"
    ] ;
    sh:property [
        sh:path :shortageQty ; sh:minInclusive 0 ;
        sh:message "S9 短缺数量不能为负"
    ] ;
    sh:property [
        sh:path :resolutionStatus ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "OPEN" "ACKNOWLEDGED" "RESOLVED" "IGNORED" ) ;
        sh:message "S9 处理状态必须来自 ResolutionStatus 枚举"
    ] .

# S10 生产订单
:ProductionOrderShape a sh:NodeShape ;
    sh:targetClass :ProductionOrder ;
    sh:property [
        sh:path :documentNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^PO-[0-9]{8}-[0-9]{4}$" ;
        sh:message "S10 生产订单号必须符合 PO-YYYYMMDD-XXXX"
    ] ;
    sh:property [
        sh:path :quantity ; sh:minCount 1 ; sh:minExclusive 0 ;
        sh:message "S10 生产数量必须大于 0"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "DRAFT" "RELEASED" "IN_PROGRESS" "COMPLETED" "CLOSED" "CANCELLED" ) ;
        sh:message "S10 生产订单状态必须来自 DocumentStatus 枚举"
    ] .

# S11 采购订单
:PurchaseOrderShape a sh:NodeShape ;
    sh:targetClass :PurchaseOrder ;
    sh:property [
        sh:path :documentNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^BUY-[0-9]{8}-[0-9]{4}$" ;
        sh:message "S11 采购订单号必须符合 BUY-YYYYMMDD-XXXX"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "DRAFT" "RELEASED" "PARTIALLY_RECEIVED" "RECEIVED" "CLOSED" "CANCELLED" ) ;
        sh:message "S11 采购订单状态必须来自 PurchaseOrderStatus 枚举"
    ] ;
    sh:property [
        sh:path :supplierId ; sh:minCount 1 ;
        sh:message "S11 采购订单必须有供应商"
    ] .

# S12 BOM
:BOMShape a sh:NodeShape ;
    sh:targetClass :BOM ;
    sh:property [
        sh:path :documentNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^BOM-[A-Z0-9._-]{2,40}$" ;
        sh:message "S12 BOM 编号必须符合 BOM-XXX"
    ] ;
    sh:property [
        sh:path :parentMaterialCode ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S12 BOM 必须指定父物料"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "DRAFT" "RELEASED" "IN_PROGRESS" "COMPLETED" "CLOSED" "CANCELLED" ) ;
        sh:message "S12 BOM 状态必须来自 DocumentStatus 枚举"
    ] .

# S13 BOM 行
:BomLineShape a sh:NodeShape ;
    sh:targetClass :BomLine ;
    sh:property [
        sh:path :componentMaterialCode ; sh:minCount 1 ;
        sh:message "S13 BOM 行必须指定组件物料"
    ] ;
    sh:property [
        sh:path :quantity ; sh:minCount 1 ; sh:minExclusive 0 ;
        sh:message "S13 BOM 用量必须大于 0"
    ] ;
    sh:property [
        sh:path :scrapRate ; sh:minInclusive 0 ; sh:maxInclusive 100 ;
        sh:message "S13 损耗率必须在 0-100 之间"
    ] .

# S14 工艺工序行
:RoutingOperationShape a sh:NodeShape ;
    sh:targetClass :RoutingOperation ;
    sh:property [
        sh:path :operationNumber ; sh:minCount 1 ;
        sh:message "S14 工序号必填"
    ] ;
    sh:property [
        sh:path :workCenterId ; sh:minCount 1 ;
        sh:message "S14 工序必须绑定工作中心"
    ] ;
    sh:property [
        sh:path :setupMinutes ; sh:minInclusive 0 ;
        sh:message "S14 调机时间不能为负"
    ] ;
    sh:property [
        sh:path :runMinutesPerUnit ; sh:minInclusive 0 ;
        sh:message "S14 单位加工时间不能为负"
    ] .

# S15 成本费率
:CostRateShape a sh:NodeShape ;
    sh:targetClass :CostRate ;
    sh:property [
        sh:path :rateType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "LABOR" "MACHINE" "OVERHEAD" ) ;
        sh:message "S15 费率类型必须来自 CostRateType 枚举"
    ] ;
    sh:property [
        sh:path :ratePerHour ; sh:minCount 1 ; sh:minInclusive 0 ;
        sh:message "S15 小时费率不能为负"
    ] ;
    sh:property [
        sh:path :currency ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S15 费率必须指定币种"
    ] .

# S16 工作中心日历
:WorkCalendarShape a sh:NodeShape ;
    sh:targetClass :WorkCalendar ;
    sh:property [
        sh:path :workCenterId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S16 日历必须绑定工作中心"
    ] ;
    sh:property [
        sh:path :shiftStart ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^([01][0-9]|2[0-3]):[0-5][0-9]$" ;
        sh:message "S16 班次开始时间必须为 HH:MM"
    ] ;
    sh:property [
        sh:path :shiftEnd ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^([01][0-9]|2[0-3]):[0-5][0-9]$" ;
        sh:message "S16 班次结束时间必须为 HH:MM"
    ] ;
    sh:property [
        sh:path :capacityHours ; sh:minCount 1 ; sh:minExclusive 0 ;
        sh:message "S16 日产能小时必须大于 0"
    ] .

# S17 齐套结果
:KittingResultShape a sh:NodeShape ;
    sh:targetClass :KittingResult ;
    sh:property [
        sh:path :kitStatus ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "FULL" "PARTIAL" "SHORT" ) ;
        sh:message "S17 齐套状态必须来自 KitStatus 枚举"
    ] ;
    sh:property [
        sh:path :requiredQty ; sh:minInclusive 0 ;
        sh:message "S17 需求数量不能为负"
    ] ;
    sh:property [
        sh:path :availableQty ; sh:minInclusive 0 ;
        sh:message "S17 可用数量不能为负"
    ] ;
    sh:property [
        sh:path :shortageQty ; sh:minInclusive 0 ;
        sh:message "S17 短缺数量不能为负"
    ] .

# S18 成本差异
:CostVarianceShape a sh:NodeShape ;
    sh:targetClass :CostVariance ;
    sh:property [
        sh:path :varianceType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "MATERIAL_PRICE" "MATERIAL_USAGE" "LABOR_RATE" "LABOR_EFFICIENCY" "OVERHEAD" ) ;
        sh:message "S18 差异类型必须来自 VarianceType 枚举"
    ] ;
    sh:property [
        sh:path :standardAmount ; sh:minInclusive 0 ;
        sh:message "S18 标准金额不能为负"
    ] ;
    sh:property [
        sh:path :actualAmount ; sh:minInclusive 0 ;
        sh:message "S18 实际金额不能为负"
    ] .

# S19 需求-供应追溯链
:PeggingLinkShape a sh:NodeShape ;
    sh:targetClass :PeggingLink ;
    sh:property [
        sh:path :demandType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "SALES_ORDER" "FORECAST" "SAFETY_STOCK" "DEPENDENT" "MPS" ) ;
        sh:message "S19 需求类型必须来自 DemandType 枚举"
    ] ;
    sh:property [
        sh:path :supplyType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "ON_HAND" "PRODUCTION_ORDER" "PURCHASE_ORDER" "PLANNED_ORDER" ) ;
        sh:message "S19 供应类型必须来自 SupplyType 枚举"
    ] ;
    sh:property [
        sh:path :peggedQty ; sh:minCount 1 ; sh:minExclusive 0 ;
        sh:message "S19 追溯数量必须大于 0"
    ] .

# S20 工单成本结算
:CostSettlementShape a sh:NodeShape ;
    sh:targetClass :CostSettlement ;
    sh:property [
        sh:path :totalCost ; sh:minCount 1 ; sh:minInclusive 0 ;
        sh:message "S20 结算总成本不能为负"
    ] ;
    sh:property [
        sh:path :wipValue ; sh:minInclusive 0 ;
        sh:message "S20 在制品价值不能为负"
    ] ;
    sh:property [
        sh:path :settlementStatus ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "OPEN" "COLLECTED" "SETTLED" ) ;
        sh:message "S20 结算状态必须来自 CostStatus 枚举"
    ] .

# S21 图级约束：MPS 计划行的物料必须是成品或半成品
:MpsEntryMaterialShape a sh:NodeShape ;
    sh:targetClass :MpsEntry ;
    sh:sparql [
        sh:message "S21 MPS 只能计划成品(FG)或半成品(SEMI)" ;
        sh:select """
            PREFIX : <https://dierp.local/ontology/erp/v1#>
            SELECT $this ?value WHERE {
                $this :materialCode ?value .
                FILTER NOT EXISTS {
                    ?m a :Material ;
                       :materialCode ?value ;
                       :materialType ?t .
                    FILTER (?t = "FG" || ?t = "SEMI")
                }
            }
        """
    ] .

# S22 标准成本
:StandardCostShape a sh:NodeShape ;
    sh:targetClass :StandardCost ;
    sh:property [
        sh:path :costId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S22 标准成本必须有成本版本号"
    ] ;
    sh:property [
        sh:path :materialCode ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S22 标准成本必须绑定物料"
    ] ;
    sh:property [
        sh:path :materialCost ; sh:minInclusive 0 ;
        sh:message "S22 标准材料成本不能为负"
    ] ;
    sh:property [
        sh:path :laborCost ; sh:minInclusive 0 ;
        sh:message "S22 标准人工成本不能为负"
    ] ;
    sh:property [
        sh:path :overheadCost ; sh:minInclusive 0 ;
        sh:message "S22 标准制造费用不能为负"
    ] ;
    sh:property [
        sh:path :unitCost ; sh:minCount 1 ; sh:minInclusive 0 ;
        sh:message "S22 单位标准成本必填且不能为负"
    ] .

# S23 工单实际成本归集
:ProductionCostShape a sh:NodeShape ;
    sh:targetClass :ProductionCost ;
    sh:property [
        sh:path :costId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S23 成本归集记录必须有编号"
    ] ;
    sh:property [
        sh:path :productionOrderNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S23 成本归集必须绑定工单"
    ] ;
    sh:property [
        sh:path :totalCost ; sh:minCount 1 ; sh:minInclusive 0 ;
        sh:message "S23 实际总成本不能为负"
    ] ;
    sh:property [
        sh:path :wipValue ; sh:minInclusive 0 ;
        sh:message "S23 在制品价值不能为负"
    ] ;
    sh:property [
        sh:path :settlementStatus ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "OPEN" "COLLECTED" "SETTLED" ) ;
        sh:message "S23 归集状态必须来自 CostStatus 枚举"
    ] .

# S24 设备资源（APS 主数据）
:ResourceShape a sh:NodeShape ;
    sh:targetClass :Resource ;
    sh:property [
        sh:path :resourceId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[A-Z0-9][A-Z0-9._-]{2,49}$" ;
        sh:message "S24 资源编码必填且只能包含大写字母、数字、点、下划线、连字符"
    ] ;
    sh:property [
        sh:path :resourceName ; sh:minCount 1 ;
        sh:message "S24 资源名称必填"
    ] ;
    sh:property [
        sh:path :workCenterId ; sh:minCount 1 ;
        sh:message "S24 资源必须绑定工作中心"
    ] ;
    sh:property [
        sh:path :resourceType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "MACHINE" "LABOR" ) ;
        sh:message "S24 资源类型必须为 MACHINE 或 LABOR"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "ACTIVE" "MAINTENANCE" "DOWN" ) ;
        sh:message "S24 资源状态必须来自 ResourceStatus 枚举"
    ] .

# S25 人员技能矩阵
:SkillMatrixShape a sh:NodeShape ;
    sh:targetClass :SkillMatrix ;
    sh:property [
        sh:path :skillId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S25 技能记录必须有技能编号"
    ] ;
    sh:property [
        sh:path :resourceId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S25 技能必须绑定资源"
    ] ;
    sh:property [
        sh:path :skillCode ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S25 技能码必填"
    ] ;
    sh:property [
        sh:path :proficiency ; sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:message "S25 熟练度必须在 0-1 之间"
    ] .

# S26 换产矩阵
:ChangeoverMatrixShape a sh:NodeShape ;
    sh:targetClass :ChangeoverMatrix ;
    sh:property [
        sh:path :changeoverId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S26 换产记录必须有编号"
    ] ;
    sh:property [
        sh:path :workCenterId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S26 换产矩阵必须绑定工作中心"
    ] ;
    sh:property [
        sh:path :changeoverMinutes ; sh:minCount 1 ; sh:minInclusive 0 ;
        sh:message "S26 换产时间不能为负"
    ] .

# S27 排程运算批次
:ScheduleRunShape a sh:NodeShape ;
    sh:targetClass :ScheduleRun ;
    sh:property [
        sh:path :documentNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^APS-[0-9]{8}-[0-9]{4}$" ;
        sh:message "S27 排程批次号必须符合 APS-YYYYMMDD-XXXX"
    ] ;
    sh:property [
        sh:path :scheduleAlgorithm ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "FORWARD" "BACKWARD" "MIXED" ) ;
        sh:message "S27 排程算法必须来自 ScheduleAlgorithm 枚举"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "DRAFT" "RUNNING" "COMPLETED" "PUBLISHED" "FAILED" ) ;
        sh:message "S27 排程批次状态必须来自 ScheduleRunStatus 枚举"
    ] ;
    sh:property [
        sh:path :horizonStart ; sh:minCount 1 ;
        sh:message "S27 排程必须有窗口开始时间"
    ] ;
    sh:property [
        sh:path :horizonEnd ; sh:minCount 1 ;
        sh:message "S27 排程必须有窗口结束时间"
    ] .

# S28 排程工序
:ScheduledOperationShape a sh:NodeShape ;
    sh:targetClass :ScheduledOperation ;
    sh:property [
        sh:path :opId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S28 排程工序必须有工序记录编号"
    ] ;
    sh:property [
        sh:path :runNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S28 排程工序必须归属排程批次"
    ] ;
    sh:property [
        sh:path :operationNumber ; sh:minCount 1 ;
        sh:message "S28 排程工序必须有工序号"
    ] ;
    sh:property [
        sh:path :workCenterId ; sh:minCount 1 ;
        sh:message "S28 排程工序必须绑定工作中心"
    ] ;
    sh:property [
        sh:path :plannedStart ; sh:minCount 1 ;
        sh:message "S28 排程工序必须有计划开始时间"
    ] ;
    sh:property [
        sh:path :plannedEnd ; sh:minCount 1 ;
        sh:message "S28 排程工序必须有计划结束时间"
    ] ;
    sh:property [
        sh:path :setupMinutes ; sh:minInclusive 0 ;
        sh:message "S28 调机时间不能为负"
    ] ;
    sh:property [
        sh:path :runMinutes ; sh:minInclusive 0 ;
        sh:message "S28 加工时间不能为负"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "PLANNED" "LOCKED" "PUBLISHED" "CANCELLED" ) ;
        sh:message "S28 排程工序状态必须来自 ScheduleOpStatus 枚举"
    ] .

# S29 排程异常
:ScheduleExceptionShape a sh:NodeShape ;
    sh:targetClass :ScheduleException ;
    sh:property [
        sh:path :exceptionId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S29 排程异常必须有异常编号"
    ] ;
    sh:property [
        sh:path :exceptionType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "CAPACITY_OVERLOAD" "DUE_DATE_RISK" "MATERIAL_SHORTAGE" "SKILL_MISMATCH" "CHANGEOVER_LIMIT" "RESOURCE_DOWN" ) ;
        sh:message "S29 排程异常类型必须来自 ScheduleExceptionType 枚举"
    ] ;
    sh:property [
        sh:path :severity ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "WARNING" "CRITICAL" ) ;
        sh:message "S29 排程异常级别必须为 WARNING 或 CRITICAL"
    ] .

# S30 插单模拟场景
:ScenarioSimulationShape a sh:NodeShape ;
    sh:targetClass :ScenarioSimulation ;
    sh:property [
        sh:path :scenarioId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S30 模拟场景必须有场景编号"
    ] ;
    sh:property [
        sh:path :runNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S30 模拟场景必须归属排程批次"
    ] ;
    sh:property [
        sh:path :scenarioType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "INSERT_ORDER" "EQUIPMENT_DOWN" "MATERIAL_DELAY" ) ;
        sh:message "S30 模拟类型必须来自 ScenarioType 枚举"
    ] .

# S31 插单影响明细
:ScenarioImpactShape a sh:NodeShape ;
    sh:targetClass :ScenarioImpact ;
    sh:property [
        sh:path :impactId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S31 影响明细必须有编号"
    ] ;
    sh:property [
        sh:path :scenarioId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S31 影响明细必须归属模拟场景"
    ] ;
    sh:property [
        sh:path :delayDays ; sh:minCount 1 ; sh:minInclusive 0 ;
        sh:message "S31 延期天数不能为负"
    ] ;
    sh:property [
        sh:path :impactLevel ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
        sh:message "S31 影响级别必须来自 LOW/MEDIUM/HIGH"
    ] .

# ─────────────────────────────────────────────────────────────
# EAM 设备管理（S32–S34）
# ─────────────────────────────────────────────────────────────

# S32 设备维护计划
:MaintenancePlanShape a sh:NodeShape ;
    sh:targetClass :MaintenancePlan ;
    sh:property [
        sh:path :planId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^MP-[0-9A-Za-z-]+$" ;
        sh:message "S32 维护计划编号必须以 MP- 开头"
    ] ;
    sh:property [
        sh:path :resourceId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S32 维护计划必须绑定设备资源"
    ] ;
    sh:property [
        sh:path :maintenanceType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "INSPECTION" "LUBRICANT" "REPAIR" "OVERHAUL" ) ;
        sh:message "S32 维护类型必须来自 MaintenanceType 枚举"
    ] ;
    sh:property [
        sh:path :cycleDays ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ;
        sh:message "S32 维护周期必须为正整数天"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "PLANNED" "IN_PROGRESS" "DONE" "CANCELLED" ) ;
        sh:message "S32 维护计划状态必须来自 MaintenanceStatus 枚举"
    ] .

# S33 维护工单
:MaintenanceOrderShape a sh:NodeShape ;
    sh:targetClass :MaintenanceOrder ;
    sh:property [
        sh:path :orderNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^MO-[0-9]{8}-[0-9]{4}$" ;
        sh:message "S33 维护工单编号必须形如 MO-YYYYMMDD-XXXX"
    ] ;
    sh:property [
        sh:path :resourceId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S33 维护工单必须绑定设备资源"
    ] ;
    sh:property [
        sh:path :maintenanceType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "INSPECTION" "LUBRICANT" "REPAIR" "OVERHAUL" ) ;
        sh:message "S33 维护类型必须来自 MaintenanceType 枚举"
    ] ;
    sh:property [
        sh:path :plannedDate ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S33 维护工单必须有计划执行日期"
    ] ;
    sh:property [
        sh:path :downtimeHours ; sh:minInclusive 0 ;
        sh:message "S33 停机时长不能为负"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "PLANNED" "IN_PROGRESS" "DONE" "CANCELLED" ) ;
        sh:message "S33 维护工单状态必须来自 MaintenanceStatus 枚举"
    ] .

# S34 设备故障记录
:EquipmentFailureShape a sh:NodeShape ;
    sh:targetClass :EquipmentFailure ;
    sh:property [
        sh:path :failureNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^EF-[0-9]{8}-[0-9]{4}$" ;
        sh:message "S34 故障编号必须形如 EF-YYYYMMDD-XXXX"
    ] ;
    sh:property [
        sh:path :resourceId ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S34 故障记录必须绑定设备资源"
    ] ;
    sh:property [
        sh:path :occurredAt ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S34 故障记录必须有发生时间"
    ] ;
    sh:property [
        sh:path :severity ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "LOW" "MEDIUM" "HIGH" "CRITICAL" ) ;
        sh:message "S34 故障严重程度必须来自 FailureSeverity 枚举"
    ] ;
    sh:property [
        sh:path :downtimeHours ; sh:minInclusive 0 ;
        sh:message "S34 停机时长不能为负"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "OPEN" "PROCESSING" "CLOSED" ) ;
        sh:message "S34 故障状态必须来自 FailureStatus 枚举"
    ] .

# ─────────────────────────────────────────────────────────────
# QMS 质量管理（S35–S36）
# ─────────────────────────────────────────────────────────────

# S35 质量检验单
:InspectionOrderShape a sh:NodeShape ;
    sh:targetClass :InspectionOrder ;
    sh:property [
        sh:path :inspectionNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^(IQC|IPQC|FQC)-[0-9]{8}-[0-9]{4}$" ;
        sh:message "S35 检验单号必须形如 IQC/IPQC/FQC-YYYYMMDD-XXXX"
    ] ;
    sh:property [
        sh:path :inspectionType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "INCOMING" "IN_PROCESS" "FINAL" ) ;
        sh:message "S35 检验类型必须来自 InspectionType 枚举"
    ] ;
    sh:property [
        sh:path :materialCode ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S35 检验单必须关联物料"
    ] ;
    sh:property [
        sh:path :quantityInspected ; sh:minCount 1 ; sh:minInclusive 0 ;
        sh:message "S35 检验数量不能为负"
    ] ;
    sh:property [
        sh:path :quantityRejected ; sh:minInclusive 0 ;
        sh:message "S35 不合格数量不能为负"
    ] ;
    sh:property [
        sh:path :result ; sh:in ( "PASS" "FAIL" "HOLD" ) ;
        sh:message "S35 检验结论必须来自 InspectionResult 枚举"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "DRAFT" "COMPLETED" "CANCELLED" ) ;
        sh:message "S35 检验单状态必须来自 InspectionStatus 枚举"
    ] .

# S36 不合格品记录
:NonConformanceReportShape a sh:NodeShape ;
    sh:targetClass :NonConformanceReport ;
    sh:property [
        sh:path :ncrNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^NCR-[0-9]{8}-[0-9]{4}$" ;
        sh:message "S36 不合格编号必须形如 NCR-YYYYMMDD-XXXX"
    ] ;
    sh:property [
        sh:path :sourceType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "INSPECTION" "REPORT" "LOT_CARD" "MANUAL" ) ;
        sh:message "S36 来源类型必须来自 NcrSourceType 枚举"
    ] ;
    sh:property [
        sh:path :materialCode ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "S36 不合格品记录必须关联物料"
    ] ;
    sh:property [
        sh:path :quantity ; sh:minCount 1 ; sh:minInclusive 0 ;
        sh:message "S36 不合格数量必须大于等于 0"
    ] ;
    sh:property [
        sh:path :severity ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "MINOR" "MAJOR" "CRITICAL" ) ;
        sh:message "S36 严重程度必须来自 NcrSeverity 枚举"
    ] ;
    sh:property [
        sh:path :disposition ; sh:in ( "REWORK" "SCRAP" "USE_AS_IS" "RETURN" "REVIEW" ) ;
        sh:message "S36 处置方式必须来自 NcrDisposition 枚举"
    ] ;
    sh:property [
        sh:path :status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "OPEN" "UNDER_REVIEW" "DISPOSITIONED" "CLOSED" ) ;
        sh:message "S36 状态必须来自 NcrStatus 枚举"
    ] .
