@startuml ENG-MI管理类图
skinparam classAttributeIconSize 0
skinparam linetype ortho

title ENG模块 - MI管理子模块类图

package "MI管理 (MI Management)" {
    
    class Material {
        +String material_code
        +String material_name
    }
    
    class Routing {
        +String routing_id
        +Enum status
    }
    
    class MI {
        +Integer id
        +String mi_number
        +String version
        +String material_code
        +String description
        +Enum status
        +Date effective_date
        +Date expiry_date
        +String content
        +String created_by
        +Timestamp created_at
        +String updated_by
        +Timestamp updated_at
        +Boolean is_deleted
    }
    
    class ProductionVersion {
        +String production_version_id
        +String mi_number
    }
    
    class LotCard {
        +String lot_number
        +String mi_number
        +String mi_content
    }
    
    ' 关系定义
    Material "1" --> "*" MI : has
    Routing "1" --> "*" MI : generates
    MI "1" --> "*" ProductionVersion : used_in
    MI "1" --> "*" LotCard : generates
    
    note right of MI
        MI（制造指令）
        状态：DRAFT, REVIEWING, APPROVED, RELEASED, OBSOLETE
        content字段：JSON格式，含工艺参数与指令集列表
        可以基于工艺路线自动生成MI草稿
        发布后的MI可用于生产版本发布和生产订单/工单下达
    end note
    
    note right of Routing
        工艺路线
        基于工艺路线可以自动生成MI草稿
        预填指令集列表
    end note
}

@enduml
