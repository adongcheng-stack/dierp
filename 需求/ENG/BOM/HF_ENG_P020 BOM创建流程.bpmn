<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.0.0">
  <bpmn:collaboration id="Collaboration_0v5v926">
    <bpmn:participant id="Participant_0hpwgn1" name="BOM创建流程" processRef="HF_ENG_P020" />
  </bpmn:collaboration>
  <bpmn:process id="HF_ENG_P020" name="BOM创建流程" isExecutable="true">
    <bpmn:documentation>适用范围: 本流程适用于所有类别BOM创建的需求，包括新单BOM的创建和ECN变更后对BOM的修改需求</bpmn:documentation>
    <bpmn:extensionElements />
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Engineering" name="工程部">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EBOMCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_ENG_P020-ZP01-010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_ENG_P020-ZP01-050</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_ENG_P020-ZP01-060</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_ENG_P020-ZP01-030</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_ENG_P020-ZP01-020</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="开始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_EBOMCheck" name="EBOM是否符合要求?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_Return</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_1" name="结束">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="HF_ENG_P020-ZP01-010" name="010: 制作MI资料">
      <bpmn:documentation>任务类型: 服务任务
系统: 工程系统
操作: MI依生管排程及MI管理系统内的排程，依据客户资料要求制作产品的MI资料，制作完的MI资料按照《PE工作指引程序文件》要求给到PPQE完成内部审核</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_ENG_P020-ZP01-050" name="050: 创建半成品料号之后生成BOM">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: ZPPXX
操作: SAP创建半成品料号之后，由SAP系统根据BOM耗用量计算规则生成成品和半成品BOM清单
输出文件: BOM清单</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0vgf9bu">
        <bpmn:targetRef>HF_ENG_P020-ZP01-DO02</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="HF_ENG_P020-ZP01-060" name="060: 下发BOM到生产执行系统">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: ZPPXX
操作: SAP系统把生成的BOM清单下发到生产执行系统</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0kk18pa">
        <bpmn:targetRef>HF_ENG_P020-ZP01-DO02</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="HF_ENG_P020-ZP01-030" name="030: 输出EBOM参数">
      <bpmn:documentation>任务类型: 服务任务
系统: 工程系统
操作: PPQE对审核后的MI资料进行输出，再输出EBOM参数</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_073ww5p">
        <bpmn:targetRef>HF_ENG_P020-ZP01-DO02</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="HF_ENG_P020-ZP01-020" name="020: 输出半成品料号">
      <bpmn:documentation>任务类型: 服务任务
系统: 工程系统
操作: PPQE对审核后的MI资料进行输出，当有半成品料号时，先输出半成品料号</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0trsbcr">
        <bpmn:targetRef>HF_ENG_P020-ZP01-DO01</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:dataObjectReference id="HF_ENG_P020-ZP01-DO02" name="BOM" dataObjectRef="DataObject_0x0orhs" />
    <bpmn:dataObject id="DataObject_0x0orhs" />
    <bpmn:dataObjectReference id="HF_ENG_P020-ZP01-DO01" name="半成品料号" dataObjectRef="DataObject_0kfba8u" />
    <bpmn:dataObject id="DataObject_0kfba8u" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="HF_ENG_P020-ZP01-010" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="HF_ENG_P020-ZP01-030" targetRef="Gateway_EBOMCheck" />
    <bpmn:sequenceFlow id="Flow_5" name="是" sourceRef="Gateway_EBOMCheck" targetRef="HF_ENG_P020-ZP01-050">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ebomMeetsRequirements == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Return" name="否" sourceRef="Gateway_EBOMCheck" targetRef="HF_ENG_P020-ZP01-010">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ebomMeetsRequirements == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="HF_ENG_P020-ZP01-060" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="HF_ENG_P020-ZP01-010" targetRef="HF_ENG_P020-ZP01-020" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="HF_ENG_P020-ZP01-050" targetRef="HF_ENG_P020-ZP01-060" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="HF_ENG_P020-ZP01-020" targetRef="HF_ENG_P020-ZP01-030" />
  </bpmn:process>
