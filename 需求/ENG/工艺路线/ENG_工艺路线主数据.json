      }
    ],
    "audit_trail": {
      "创建人": "User_007",
      "创建时间": "2023-09-28",
      "最后修改人": "User_009",
      "关联变更单": "ECN-2023-889"
    }
  },
  "ui_specifications": {
    "design_system": {
      "primary_color": "#1677ff",
      "success_color": "#52c41a",
      "warning_color": "#faad14",
      "error_color": "#ff4d4f",
      "external_color": "#fa8c16",
      "quality_color": "#73d13d",
      "text_primary": "#000000e0",
      "text_secondary": "#00000073",
      "border_color": "#d9d9d9",
      "background_light": "#f5f5f5",
      "card_background": "#ffffff",
      "shadow_light": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px 0 rgba(0, 0, 0, 0.02)",
      "shadow_medium": "0 3px 6px -4px rgba(0, 0, 0, 0.12), 0 6px 16px 0 rgba(0, 0, 0, 0.08), 0 9px 28px 8px rgba(0, 0, 0, 0.05)",
      "border_radius": "8px",
      "transition": "all 0.3s cubic-bezier(0.645, 0.045, 0.355, 1)"
    },
    "layout": {
      "responsive_breakpoints": {
        "mobile": "768px",
        "tablet": "992px"
      },
      "form_layout": "grid_responsive",
      "card_based_design": true
    },
    "interaction": {
      "drag_and_drop": true,
      "modal_overlay": true,
      "row_hover_effects": true,
      "click_outside_to_close_modal": true
    },
    "icon_library": "Font Awesome 6.4.0",
    "font_family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
  }
}