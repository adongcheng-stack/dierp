      "Panel尺寸": "18x24 INCH"
    },
    "operations": [
      {
        "operation_id": "0010",
        "operation_no": "0010",
        "operation_name": "CNC钻孔 / 数控钻孔",
        "operation_type": "internal",
        "work_center": "WC-DRL-CNC-A",
        "cost_relevant": true,
        "scheduling_relevant": true,
        "sop_url": "http://docs.factory/sop/drl-v3.pdf"
      },
      {
