    {
      "opSequence": 0010,
      "opName": "CNC Drilling / 数控钻孔",
      "opCode": "DRL-001",
      
      // 【核心实体】：物理存在的机器组
      "workCenterId": "WC-DRL-CNC-A",
      
      // 【控制逻辑】：替代 SAP Control Key
      "processBehavior": {
