  <bpmn:collaboration id="Collaboration_1ntglit">
    <bpmn:participant id="HF-SD-P010-ZP03P" name="客户主数据-维护送货地址 HF-SD-P010-ZP03" processRef="HF-SD-P010-ZP03" />
  </bpmn:collaboration>
  <bpmn:process id="HF-SD-P010-ZP03" name="客户主数据-维护送货地址" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="0.1" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_05a0i6x">
      <bpmn:lane id="Lane_0gefdu6" name="跟单员 - 市场部">
        <bpmn:flowNodeRef>HF-SD-P010-ZP03-S020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P010-ZP03-S030</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0li1ogc" name="业务员 - 市场部">
        <bpmn:flowNodeRef>HF-SD-P010-ZP03-S010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0tw57pc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P010-ZP03-S040</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0iga4lj</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObjectReference id="HF-SD-P010-ZP03-D01-00" name="送货地址维护信息表" dataObjectRef="DataObject_1c84pyd">
      <bpmn:documentation>例：《客户信息维护申请表》、《新客户授信额度申请表》、《客户登记评价表》、《客户等级登记表》</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DataObject_1c84pyd" />
    <bpmn:manualTask id="HF-SD-P010-ZP03-S010" name="010: 提出维护申请">
      <bpmn:documentation>业务提出送货地址维护需求</bpmn:documentation>
      <bpmn:incoming>Flow_0r3ff1x</bpmn:incoming>
      <bpmn:outgoing>Flow_1wr5lrn</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:startEvent id="Event_0tw57pc" name="开始">
      <bpmn:documentation>适用范围：客户增加新的送货地址和修改已有的送货地址，并将送货地址分配给客户。</bpmn:documentation>
      <bpmn:outgoing>Flow_0r3ff1x</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="HF-SD-P010-ZP03-S020" name="020: 增加/修改送货地址">
      <bpmn:documentation>跟单员在ERP中创建或修改送货地址信息</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1wr5lrn</bpmn:incoming>
      <bpmn:outgoing>Flow_180900f</bpmn:outgoing>
      <bpmn:property id="Property_0qj640n" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_0fa7ldr">
        <bpmn:sourceRef>DataObjectReference_0opy4sr</bpmn:sourceRef>
        <bpmn:targetRef>Property_0qj640n</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0568e7w">
        <bpmn:targetRef>HF-MDM-010-SD</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:dataStoreReference id="HF-MDM-010-SD" name="客户主数据">
      <bpmn:documentation>！！！主数据的表单设计
属性和状态？</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataObjectReference id="DataObjectReference_0opy4sr" name="送货地址维护信息表" dataObjectRef="DataObject_021f9id">
      <bpmn:documentation>例：《客户信息维护申请表》、《新客户授信额度申请表》、《客户登记评价表》、《客户等级登记表》</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DataObject_021f9id" />
    <bpmn:userTask id="HF-SD-P010-ZP03-S030" name="030: 绑定送货地址到下单客户">
      <bpmn:documentation>跟单员绑定送货地址和下单客户</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_180900f</bpmn:incoming>
      <bpmn:outgoing>Flow_0fdycit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF-SD-P010-ZP03-S040" name="040: 业务员复核">
      <bpmn:documentation>业务员复核系统录入信息</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0fdycit</bpmn:incoming>
      <bpmn:outgoing>Flow_17xvrug</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_0iga4lj" name="结束">
      <bpmn:incoming>Flow_17xvrug</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0r3ff1x" sourceRef="Event_0tw57pc" targetRef="HF-SD-P010-ZP03-S010" />
    <bpmn:sequenceFlow id="Flow_1wr5lrn" sourceRef="HF-SD-P010-ZP03-S010" targetRef="HF-SD-P010-ZP03-S020" />
