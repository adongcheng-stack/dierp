  <bpmn:collaboration id="Collaboration_0ti9p8s">
    <bpmn:participant id="HF-SD-P010-ZP02P" name="客户主数据修改 HF-SD-P010-ZP02" processRef="Process_1pkbtc0" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1pkbtc0" isExecutable="true">
    <bpmn:laneSet id="LaneSet_0disvxx">
      <bpmn:lane id="Lane_1yudni5" name="应收会计 - 财务部 / 主数据维护">
        <bpmn:flowNodeRef>HF-SD-P010-ZP02-S030</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P010-ZP02-S040</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1jgafb6" name="业务员 - 市场部">
        <bpmn:flowNodeRef>HF-SD-P010-ZP02-S010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0f9pgkv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P010-ZP02-S011</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P010-ZP02-S050</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1x2ypqd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0aexc5w" name="销售总监 / 销售管理">
        <bpmn:flowNodeRef>HF-SD-P010-ZP02-S020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P010-ZP02-S020-Gateway_approval_check</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:manualTask id="HF-SD-P010-ZP02-S010" name="010: 提出修改申请">
      <bpmn:documentation>业务在OA中提变更需求，包含：修改、冻结、解冻；
提交的资料包括《客户信息维护申请表》、《客户登记评价表》、《
客户等级登记表》。

[角色]: 业务员
[线下操作]: 业务员填写《客户信息维护申请表》或《客户登记评价表》或《客户等级登记表》。
[业务规则]:</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1r0mex9</bpmn:incoming>
      <bpmn:outgoing>Flow_0rtyk2q</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:startEvent id="Event_0f9pgkv" name="开始">
      <bpmn:documentation>适用范围：客户资料更新（客户名称/客户地址/开票方/送达方/付款条件/付款期限/贸易条件、客户等级，以及客户冻结、解冻流程。
（授信额度变更除外，走额度变更流程）</bpmn:documentation>
      <bpmn:outgoing>Flow_1r0mex9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="HF-SD-P010-ZP02-S020" name="020: 客户变更审批">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0rtyk2q</bpmn:incoming>
      <bpmn:outgoing>Flow_1nipgj1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P010-ZP02-S020-Gateway_approval_check" name="Gateway_Approval_Check">
      <bpmn:incoming>Flow_1nipgj1</bpmn:incoming>
      <bpmn:outgoing>SD-P010-ZP02-S020-Rejected</bpmn:outgoing>
      <bpmn:outgoing>SD-P010-ZP02-S020-Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataObjectReference id="HF-SD-P010-ZP02-D01-10" name="客户资料变更表" dataObjectRef="DataObject_0qwh8zy">
      <bpmn:documentation>例：《客户信息维护申请表》、《新客户授信额度申请表》、《客户登记评价表》、《客户等级登记表》</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DataObject_0qwh8zy" />
    <bpmn:manualTask id="HF-SD-P010-ZP02-S011" name="011: 更新/补充客户资料">
      <bpmn:documentation>业务员收集创建新客户需要的相关资料，并在XX系统中提交审批</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>SD-P010-ZP02-S020-Rejected</bpmn:incoming>
    </bpmn:manualTask>
    <bpmn:userTask id="HF-SD-P010-ZP02-S030" name="030: 修改客户主数据">
      <bpmn:documentation>应收会计/主数据维护岗统一修改客户主数据</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="" />
      </bpmn:extensionElements>
      <bpmn:incoming>SD-P010-ZP02-S020-Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_1s9sz9s</bpmn:outgoing>
      <bpmn:property id="Property_0ehxlfj" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_0w3hw3x">
        <bpmn:sourceRef>HF-SD-P010-ZP02-D01-01</bpmn:sourceRef>
        <bpmn:targetRef>Property_0ehxlfj</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1hkjh5q">
        <bpmn:targetRef>HF-MDM-010-SD</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:dataObjectReference id="HF-SD-P010-ZP02-D01-01" name="客户资料变更表" dataObjectRef="DataObject_0qw46ck">
      <bpmn:documentation>例：《客户信息维护申请表》、《新客户授信额度申请表》、《客户登记评价表》、《客户等级登记表》</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DataObject_0qw46ck" />
    <bpmn:dataStoreReference id="HF-MDM-010-SD" name="客户主数据">
      <bpmn:documentation>！！！主数据的表单设计
属性和状态？</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:userTask id="HF-SD-P010-ZP02-S040" name="040: 财务经理复核">
      <bpmn:documentation>财务经理复核</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
