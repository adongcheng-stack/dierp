<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.0.0">
  <bpmn:collaboration id="Collaboration_0j2mbgv">
    <bpmn:participant id="Participant_019emkc" name="销售对账开票" processRef="HF-SD-P110" />
    <bpmn:textAnnotation id="TextAnnotation_0btarur">
      <bpmn:text>财务系统中开发票</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ucohsk" associationDirection="None" sourceRef="HF-SD-P110-Z01-090" targetRef="TextAnnotation_0btarur" />
  </bpmn:collaboration>
  <bpmn:process id="HF-SD-P110" name="内外销对账开票流程" isExecutable="true">
    <bpmn:documentation>适用范围: 内外销对账开票流程</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="0.1" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Merchandiser" name="跟单员">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_HF-SD-P070</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P110-Z01-020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_030</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P110-Z01-010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P110-Z01-040</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="应收会计/财务经理">
        <bpmn:flowNodeRef>Task_070</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_080</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P110-Z01-050</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P110-Z01-060</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P110-Z01-090</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="开始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="SubProcess_HF-SD-P070" name="销售签收流程">
      <bpmn:documentation>任务类型: 子流程
操作: 承接销售签收流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="HF_SD_P070" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="HF-SD-P110-Z01-020" name="020: 发对账单给客户确认">
      <bpmn:documentation>任务类型: 用户任务
操作: 跟单员将对账单发给客户确认</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="userTask" />
        <zeebe:assignmentDefinition assignee="${merchandiserAssignee}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_030" name="客户确认对账单?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_Return</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_070" name="070: 财务经理复核">
      <bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="userTask" />
          <zeebe:assignmentDefinition assignee="${financeManagerAssignee}" />
        </bpmn:extensionElements>
任务类型: 用户任务
系统: SAP系统
      
操作: 财务经理复核      </bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_080" name="是否内销?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SubProcess_Payment" name="客户(预)收款流程">
      <bpmn:documentation>任务类型: 子流程
操作: 承接客户(预)收款流程</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_1" name="结束">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="HF-SD-P110-Z01-010" name="010: 勾选出货明细 生成对账单">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
输出文件: 对账单
操作: 跟单员根据出货明细勾选出本期需对账明细生成对账单，对账单统一格式</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF-SD-P110-Z01-050" name="050: 核对对账单">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
输入文件: 对账单、客户订单
操作: 财务核对对账单</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF-SD-P110-Z01-060" name="060: 应收会计系统开票">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
操作: 财务开系统发票，产生应收。开票分两步走，会计开票，组长审批</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="HF-SD-P110-Z01-090" name="090: 开金税发票">
      <bpmn:documentation>任务类型: 服务任务
系统: 金税系统
操作: 如果是内销，需要开金税发票，金税开票可能需要修改产品描述、适用客户料号开票等，按客户要求开票</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="HF-SD-P110-Z01-040" name="040: 提交对账单">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
操作: 提交对账单给财务确认</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="SubProcess_HF-SD-P070" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SubProcess_HF-SD-P070" targetRef="HF-SD-P110-Z01-010" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="HF-SD-P110-Z01-010" targetRef="HF-SD-P110-Z01-020" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="HF-SD-P110-Z01-020" targetRef="Gateway_030" />
    <bpmn:sequenceFlow id="Flow_5" name="是" sourceRef="Gateway_030" targetRef="HF-SD-P110-Z01-040">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerConfirmed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Return" name="否" sourceRef="Gateway_030" targetRef="HF-SD-P110-Z01-010">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerConfirmed == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="HF-SD-P110-Z01-060" targetRef="Task_070" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_070" targetRef="Gateway_080" />
    <bpmn:sequenceFlow id="Flow_10" name="是" sourceRef="Gateway_080" targetRef="HF-SD-P110-Z01-090">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isDomesticSales == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="否" sourceRef="Gateway_080" targetRef="SubProcess_Payment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isDomesticSales == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="HF-SD-P110-Z01-090" targetRef="SubProcess_Payment" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="SubProcess_Payment" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="HF-SD-P110-Z01-040" targetRef="HF-SD-P110-Z01-050" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="HF-SD-P110-Z01-050" targetRef="HF-SD-P110-Z01-060" />
  </bpmn:process>
