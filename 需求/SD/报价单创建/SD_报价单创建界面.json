{
  "module": "SD - 销售与分销",
  "version": "1.3",
  "last_updated": "2025-12-04",
  "interfaces": [
     {
      "name": "报价单创建界面",
      "id": "quotation_creation",
      "description": "用于创建和提交客户报价单的界面",
      "form_groups": [
        {
          "type": "row",
          "fields": [
            {
              "label": "客户信息",
              "type": "select",
              "options": ["ABC电子", "XYZ科技", "123通信"],
              "required": true
            },
            {
              "label": "联系人",
              "type": "text",
              "readonly": true,
              "default_value": "张三"
            }
          ]
        },
        {
          "type": "row",
          "fields": [
            {
              "label": "产品系列",
              "type": "select",
              "options": ["HS10 标准系列", "HS20 高频系列", "HS30 高速系列"],
              "required": true
            },
            {
              "label": "层数",
              "type": "select",
              "options": ["4层", "6层", "8层"],
              "required": true
            }
          ]
        },
        {
          "type": "single",
          "fields": [
            {
              "label": "14位编号",
              "type": "text",
              "readonly": true,
              "default_value": "HS1004ENIGAB01"
            }
          ]
        }
      ],
      "buttons": ["保存草稿", "提交审核", "打印预览", "取消"]
    }
  ]
}