<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_082t1cd">
    <bpmn:participant id="HF-SD-P020P" name="销售报价流程 HF-SD-P020" processRef="HF-SD-P020" />
  </bpmn:collaboration>
  <bpmn:process id="HF-SD-P020" name="销售报价流程" isExecutable="true">
    <bpmn:documentation>适用范围: 询价报价、季度降价、其他价格调整流程</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="0.1" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_MarketVP" name="市场副总/总经理 - 审批者">
        <bpmn:flowNodeRef>HF-SD-P020-S070</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SD-P020-S070-Gateway_Approval_Check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EngineeringQuoter" name="报价岗 - 工程部">
        <bpmn:flowNodeRef>HF-SD-P020-S030</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P020-S040</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SD-P020-Gateway_DataIntegrity_Check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Salesperson" name="业务员 - 市场部">
        <bpmn:flowNodeRef>HF-SD-P020-S010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P020-S020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P020-S060</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SD-P020-S060-Gateway_AutoApproval_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P020-S080</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P020-S090</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SD-P020-S090-Gateway_CustomerAccept_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P020-S100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P020-S050</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1lcbzjf</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:manualTask id="HF-SD-P020-S010" name="010: 接收客户询价请求">
      <bpmn:documentation>任务类型: 用户任务
输入输出文件: 客户报价资料
操作: 业务员接收客户的询价报价</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>SD-P020-S030-Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_069yfz9</bpmn:outgoing>
      <bpmn:property id="Property_11n8eir" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1myfjyo">
        <bpmn:sourceRef>DataObjectReference_1kw3lw4</bpmn:sourceRef>
        <bpmn:targetRef>Property_11n8eir</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:startEvent id="StartEvent_1" name="开始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="HF-SD-P020-S020" name="020: 创建报价单（录入客户编号）">
      <bpmn:documentation>任务类型: 服务任务
系统: 报价系统
输入输出文件: 报价单
操作: 业务员在报价系统中创建报价单</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0df13f6">
        <bpmn:targetRef>HF-SD-P020-DO01-New</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:dataObjectReference id="HF-SD-P020-DO01-New" name="报价单" dataObjectRef="DataObject_16qcho5" />
    <bpmn:dataObject id="DataObject_16qcho5" />
    <bpmn:userTask id="HF-SD-P020-S030" name="030: 检查资料是否完整">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_06da1c4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="HF-SD-P020-S060" name="060: 系统判断是否需要人工审批">
      <bpmn:documentation>1、报价≥核算成本*110%，系统自动通过
2、核算成本*105%≤报价＜核算成本*110%，提交市场总监审批
3、报价＜核算成本*105%，提交总经理审批</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="System Judgement" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_1dwpeyw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="SD-P020-S060-Gateway_AutoApproval_Check" name="Gateway_AutoApproval_Check">
      <bpmn:incoming>Flow_1dwpeyw</bpmn:incoming>
      <bpmn:outgoing>SD-P020-S060-UserApproval</bpmn:outgoing>
      <bpmn:outgoing>SD-P020-S060-AutoApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="HF-SD-P020-S080" name="080: 生成正式报价单，发送给客户">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>SD-P020-S060-AutoApproval</bpmn:incoming>
      <bpmn:incoming>SD-P020-S070-Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_0w1cxp5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF-SD-P020-S090" name="090: 客户是否接受报价?">
      <bpmn:documentation>任务类型: 用户任务
操作: 业务员与客户沟通报价
如果客户不接受报价，进行议价
结果: Y: 客户接受 → 070, N: 客户不接受 → 结束</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0w1cxp5</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="SD-P020-S090-Gateway_CustomerAccept_Check" name="客户是否接受?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>SD-P020-S090-Accepted</bpmn:outgoing>
      <bpmn:outgoing>SD-P020-S090-Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="HF-SD-P020-S100" name="100: 上传报价确认到系统">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
操作: 业务员上传最终报价到SAP，生成销售价格</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>SD-P020-S090-Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0k73i44">
        <bpmn:targetRef>xxx</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="xxx" name="报价单" />
    <bpmn:endEvent id="EndEvent_Success" name="结束">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="HF-SD-P020-S050" name="050: 更新报价单，提交审批">
      <bpmn:documentation>任务类型: 用户任务
系统: 报价系统
输入输出文件: 报价单
操作: 业务员审核工程部门的报价明细并报价给客户</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0e83e9w</bpmn:incoming>
      <bpmn:incoming>SD-P020-S090-Rejected</bpmn:incoming>
      <bpmn:incoming>SD-P020-S070-Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0lemmzf">
        <bpmn:targetRef>HF-SD-P020-DO01-Modified</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:dataObjectReference id="HF-SD-P020-DO01-Modified" name="报价单" dataObjectRef="DataObject_0wk3xv0" />
    <bpmn:dataObject id="DataObject_0wk3xv0" />
    <bpmn:dataObjectReference id="HF-SD-P020-DO01-Updated" name="报价单" dataObjectRef="DataObject_1wnzmid" />
    <bpmn:dataObject id="DataObject_1wnzmid" />
    <bpmn:userTask id="HF-SD-P020-S040" name="040: 资料审核并进行成本核算">
      <bpmn:documentation>任务类型: 服务任务
系统: 报价系统
输入输出文件: 报价单、成本清单
操作: 工程报价员进行资料审核并进行成本核算</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>SD-P020-S030-Passed</bpmn:incoming>
      <bpmn:outgoing>Flow_0e83e9w</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0izby3o">
        <bpmn:targetRef>HF-SD-P020-DO01-Updated</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="HF-SD-P020-S070" name="070: 审批者根据审批申请信息，决定是否通过">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>SD-P020-S060-UserApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_1d1sdcs</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="SD-P020-S070-Gateway_Approval_Check" name="Gateway_Approval_Check">
      <bpmn:incoming>Flow_1d1sdcs</bpmn:incoming>
      <bpmn:outgoing>SD-P020-S070-Rejected</bpmn:outgoing>
      <bpmn:outgoing>SD-P020-S070-Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SD-P020-S030-Rejected" name="驳回" sourceRef="SD-P020-Gateway_DataIntegrity_Check" targetRef="HF-SD-P020-S010">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="HF-SD-P020-S010" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_1lcbzjf" targetRef="HF-SD-P020-S020" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="HF-SD-P020-S020" targetRef="HF-SD-P020-S030" />
    <bpmn:sequenceFlow id="Flow_06da1c4" sourceRef="HF-SD-P020-S030" targetRef="SD-P020-Gateway_DataIntegrity_Check" />
    <bpmn:sequenceFlow id="SD-P020-S030-Passed" name="通过" sourceRef="SD-P020-Gateway_DataIntegrity_Check" targetRef="HF-SD-P020-S040">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="HF-SD-P020-S050" targetRef="HF-SD-P020-S060" />
    <bpmn:sequenceFlow id="Flow_1dwpeyw" sourceRef="HF-SD-P020-S060" targetRef="SD-P020-S060-Gateway_AutoApproval_Check" />
    <bpmn:sequenceFlow id="SD-P020-S060-UserApproval" name="UserApproval" sourceRef="SD-P020-S060-Gateway_AutoApproval_Check" targetRef="HF-SD-P020-S070">
      <bpmn:documentation>需要人工审批</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SD-P020-S060-AutoApproval" name="AutoApproval" sourceRef="SD-P020-S060-Gateway_AutoApproval_Check" targetRef="HF-SD-P020-S080">
      <bpmn:documentation>不需要人工审批</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SD-P020-S070-Approved" name="Yes" sourceRef="SD-P020-S070-Gateway_Approval_Check" targetRef="HF-SD-P020-S080">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0w1cxp5" sourceRef="HF-SD-P020-S080" targetRef="HF-SD-P020-S090" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="HF-SD-P020-S090" targetRef="SD-P020-S090-Gateway_CustomerAccept_Check" />
    <bpmn:sequenceFlow id="SD-P020-S090-Accepted" name="Yes" sourceRef="SD-P020-S090-Gateway_CustomerAccept_Check" targetRef="HF-SD-P020-S100">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SD-P020-S090-Rejected" name="No" sourceRef="SD-P020-S090-Gateway_CustomerAccept_Check" targetRef="HF-SD-P020-S050">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="HF-SD-P020-S100" targetRef="EndEvent_Success" />
    <bpmn:sequenceFlow id="Flow_0e83e9w" sourceRef="HF-SD-P020-S040" targetRef="HF-SD-P020-S050" />
    <bpmn:sequenceFlow id="SD-P020-S070-Rejected" name="No" sourceRef="SD-P020-S070-Gateway_Approval_Check" targetRef="HF-SD-P020-S050">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1d1sdcs" sourceRef="HF-SD-P020-S070" targetRef="SD-P020-S070-Gateway_Approval_Check" />
    <bpmn:exclusiveGateway id="SD-P020-Gateway_DataIntegrity_Check" name="Gateway_DataIntegrity_Check">
      <bpmn:incoming>Flow_06da1c4</bpmn:incoming>
      <bpmn:outgoing>SD-P020-S030-Rejected</bpmn:outgoing>
      <bpmn:outgoing>SD-P020-S030-Passed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataObjectReference id="DataObjectReference_1kw3lw4" name="客户报价资料" dataObjectRef="DataObject_0dm8jzm" />
    <bpmn:dataObject id="DataObject_0dm8jzm" />
    <bpmn:sequenceFlow id="Flow_069yfz9" sourceRef="HF-SD-P020-S010" targetRef="Activity_1lcbzjf" />
    <bpmn:serviceTask id="Activity_1lcbzjf" name="是否有价格协议？">
      <bpmn:incoming>Flow_069yfz9</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
