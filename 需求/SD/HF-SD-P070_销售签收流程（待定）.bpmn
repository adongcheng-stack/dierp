<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.0.0">
  <bpmn:collaboration id="Collaboration_0yfvne7">
    <bpmn:participant id="Participant_0meoykl" name="销售签收" processRef="HF_SD_P070" />
  </bpmn:collaboration>
  <bpmn:process id="HF_SD_P070" name="销售签收流程" isExecutable="true">
    <bpmn:documentation>适用范围: 销售出库后, 客户签收管理和运费分摊管理。客户签收是作为对账的前提。也是产生应收的一个前置重要环节。</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="0.1" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_TransportManager" name="运输管理员">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_HF-SD-P060</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_SD_P070-ZP01-010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_SD_P070-ZP01-030</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_SD_P070-ZP01-040</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_SD_P070-ZP01-020</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Salesperson" name="业务员">
        <bpmn:flowNodeRef>SubProcess_HF-SD-P110</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="开始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="SubProcess_HF-SD-P060" name="销售发货流程">
      <bpmn:documentation>任务类型: 子流程
操作: 承接销售发货流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="HF-SD-P060" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="HF_SD_P070-ZP01-010" name="010: 接收客户签收确认单">
      <bpmn:documentation>任务类型: 用户任务
输入输出文件: 客户签收明细
操作: 接受客户确认单《客户签收明细表》</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="userTask" />
        <zeebe:assignmentDefinition assignee="${transportManagerAssignee}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="SubProcess_HF-SD-P110" name="销售对账开票流程">
      <bpmn:documentation>任务类型: 子流程
操作: 承接销售对账开票流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="HF-SD-P110" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="HF_SD_P070-ZP01-030" name="030: 运费对账">
      <bpmn:documentation>任务类型: 用户任务
操作: 运输管理员和物流公司做运费对账</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="userTask" />
        <zeebe:assignmentDefinition assignee="${transportManagerAssignee}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="HF_SD_P070-ZP01-040" name="040: 根据收货确认单或拖运单分摊运费">
      <bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="external" retries="3" />
        </bpmn:extensionElements>
任务类型: 服务任务
系统: SAP系统
操作: 运输管理员根据物流公司提供的运输发票，在系统分摊运费到交货单
      
运费分摊规则:
1、按照公斤(尺)计算
2、中港车按照《货物托运单》确认
3、国内与国际的运费以《收货确认单》为准      </bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="结束">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="HF_SD_P070-ZP01-020" name="020: 创建确认签收单">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
操作: 运输管理员在SAP中创建确认签收单
外销: 参考业务创建的收货确认单，勾选交货单确认签收
内销: 参考托动单勾选交货单确认签收
系统做确认签收，也是做为后续对账开票的依据</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="SubProcess_HF-SD-P060" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SubProcess_HF-SD-P060" targetRef="HF_SD_P070-ZP01-010" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="HF_SD_P070-ZP01-010" targetRef="HF_SD_P070-ZP01-020" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="HF_SD_P070-ZP01-020" targetRef="SubProcess_HF-SD-P110" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="SubProcess_HF-SD-P110" targetRef="HF_SD_P070-ZP01-030" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="HF_SD_P070-ZP01-020" targetRef="HF_SD_P070-ZP01-030" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="HF_SD_P070-ZP01-030" targetRef="HF_SD_P070-ZP01-040" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="HF_SD_P070-ZP01-040" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_0yfvne7">
      <bpmndi:BPMNShape id="Participant_0meoykl_di" bpmnElement="Participant_0meoykl" isHorizontal="true">
        <dc:Bounds x="160" y="50" width="1340" height="500" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Salesperson_di" bpmnElement="Lane_Salesperson" isHorizontal="true">
        <dc:Bounds x="190" y="350" width="1310" height="200" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_TransportManager_di" bpmnElement="Lane_TransportManager" isHorizontal="true">
        <dc:Bounds x="190" y="50" width="1310" height="300" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="292" y="179" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="299" y="222" width="23" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_SubProcess_SalesDelivery" bpmnElement="SubProcess_HF-SD-P060">
        <dc:Bounds x="400" y="157" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_Task_010" bpmnElement="HF_SD_P070-ZP01-010">
        <dc:Bounds x="560" y="157" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_SubProcess_ReconciliationInvoicing" bpmnElement="SubProcess_HF-SD-P110">
        <dc:Bounds x="910" y="430" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_Task_030" bpmnElement="HF_SD_P070-ZP01-030">
        <dc:Bounds x="1040" y="157" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_Task_040" bpmnElement="HF_SD_P070-ZP01-040">
        <dc:Bounds x="1200" y="157" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_EndEvent_2" bpmnElement="EndEvent_1">
        <dc:Bounds x="1362" y="179" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1368" y="155" width="23" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1gbd1zr_di" bpmnElement="HF_SD_P070-ZP01-020">
        <dc:Bounds x="720" y="157" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="328" y="197" />
        <di:waypoint x="400" y="197" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="500" y="197" />
        <di:waypoint x="560" y="197" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="660" y="197" />
        <di:waypoint x="720" y="197" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="820" y="197" />
        <di:waypoint x="850" y="197" />
        <di:waypoint x="850" y="470" />
        <di:waypoint x="910" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1010" y="470" />
