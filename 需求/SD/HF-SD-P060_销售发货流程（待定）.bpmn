        <dc:Bounds x="990" y="167" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_1nn42d6" bpmnElement="Gateway_070" isMarkerVisible="true">
        <dc:Bounds x="1312" y="482" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1301" y="539" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_13ngr6l" bpmnElement="HF-SD-P060-ZP01-080">
        <dc:Bounds x="1440" y="167" width="100" height="80" />
      </bpmndi:BPMNShape>
