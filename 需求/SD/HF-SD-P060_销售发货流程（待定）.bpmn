<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_1roupqo">
    <bpmn:participant id="Participant_0o8cv17" name="销售发货" processRef="Process_0outv5n" />
    <bpmn:textAnnotation id="TextAnnotation_1oi91zt">
      <bpmn:text>预留MVP默认通过</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_0outv5n" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1l42sl5">
      <bpmn:lane id="Lane_OrderClerk" name="跟单员 - 市场部">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_030</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-050</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-080</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-110</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-120</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-140</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-040</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0gdjt3o</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WarehouseManager" name="成品仓管员 - 供应链管理中心">
        <bpmn:flowNodeRef>Gateway_070</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-090</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-130</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0nznf4h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-060</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TransportCustoms" name="运输管理员/报关员">
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-170</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-160</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF-SD-P060-ZP01-150</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="开始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="HF-SD-P060-ZP01-010" name="010: 安排出货计划">
      <bpmn:documentation>任务类型: 用户任务
输出文件: 客户出货排程
操作: 跟单员根据销客户的出货排程做出货计划，出货计划需提前一天发给计划和仓库；原则是出货前一天的17:30之前</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_030" name="是否公司间销售直发出库?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="HF-SD-P060-ZP01-050" name="050: 如信贷超账期,则提示">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
操作: 接单公司创建DN，会检查信贷是否超账期。如果超账期系统则会提示。原则是提示但不限制出货</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_070" name="库存是否满足?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="HF-SD-P060-ZP01-080" name="080: 沟通确认最终交货数量">
      <bpmn:documentation>任务类型: 用户任务
操作: 库存不能满足交货需求，仓库和业务沟通，确认最终交货数量</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="${orderClerkAssignee}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Return</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="HF-SD-P060-ZP01-090" name="090: 按实际数量出货，ERP同步过账">
      <bpmn:documentation>任务类型: 服务任务
系统: WMS系统、SAP系统
输出文件: 出库单
操作: 仓库在WMS根据实际数量确认出货，同步SAP自动修改数量并过账。仓库在WMS打印出库单</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_100" name="是否公司间销售出库?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="HF-SD-P060-ZP01-110" name="110: 接单公司自动收货入库">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
操作: 如果是公司间销售出库，接单公司自动创建PO并收货入库</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="HF-SD-P060-ZP01-130" name="130: 创建拖运单（Transport Order）">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
输出文件: 拖运单
操作: 仓库安排装车，并创建拖运单，作为运输管理员签收和分摊运费的依据</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_0sqc1k7</bpmn:incoming>
      <bpmn:outgoing>Flow_1i8f5jg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="HF-SD-P060-ZP01-170" name="170: 打印快递单,检查并发货">
      <bpmn:documentation>任务类型: 用户任务
操作: 运输管理员打印快递单，检查并发货</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="${transportManagerAssignee}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0rt2is8</bpmn:incoming>
      <bpmn:incoming>Flow_1fw1irj</bpmn:incoming>
      <bpmn:incoming>Flow_0yw3ow7</bpmn:incoming>
      <bpmn:outgoing>Flow_0a2a7cj</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="结束">
      <bpmn:incoming>Flow_0ewgnn8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="HF-SD-P060-ZP01-020" name="020: 创建交货单并确认运输方式">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
输出文件: 出货计划
操作: 跟单员在生产公司创建交货单，并选择运输方式；如果是公司间销售(如广合国际接单,广州广合生产)，还需要选择是否直发客户，及时交仓</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="Activity_0nznf4h" name="HF_SD_070&#10;销售签收流程">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="HF_SD_P070" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0a2a7cj</bpmn:incoming>
      <bpmn:outgoing>Flow_0ewgnn8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="HF-SD-P060-ZP01-120" name="120: 接单公司发货出库">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
操作: 对于公司间销售出库：如果是直发客户，接单公司自动过账出库；否则暂不安排交仓，业务在安排交仓后，在接单公司创建DN，过账出库</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_0sqc1k7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="HF-SD-P060-ZP01-060" name="060: 根据交货单拣货">
      <bpmn:documentation>任务类型: 用户任务
输出文件: 交货单清单
操作: 业务将生产公司创建的交货单清单发给仓库，并同时邮件通知计划和仓库。仓库打印交货单安排拣货；运输管理员可以安排订车</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_1aa44zr</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="HF-SD-P060-ZP01-160" name="160: 安排订车">
      <bpmn:documentation>任务类型: 用户任务
操作: 关务安排订仓</bpmn:documentation>
      <bpmn:incoming>Flow_1aa44zr</bpmn:incoming>
      <bpmn:outgoing>Flow_1fw1irj</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="HF-SD-P060-ZP01-140" name="140: 创建收货确认单（Goods Receipt Confirmation）">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
操作: 如果是外销：业务要及时在SAP中创建接单公司的收货确认单，作为运输管理员在系统中确认签收和分摊运费的依据</bpmn:documentation>
      <bpmn:incoming>Flow_1i8f5jg</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="HF-SD-P060-ZP01-040" name="040: 接单公司自动创建交货单（Delivery Note）">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
操作: 如果是公司间销售直发出库，接单公司自动创建交货单</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0gdjt3o" name="是否是外销订单">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_0yw3ow7</bpmn:outgoing>
      <bpmn:outgoing>Flow_1gu6qqg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="HF-SD-P060-ZP01-150" name="150: 打印报关资料维护报关记录，上传报关单(外销)">
      <bpmn:documentation>任务类型: 用户任务
系统: SAP系统
操作: 报关员打印报关资料，维护报关记录，上传报关单</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="${customsBrokerAssignee}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1gu6qqg</bpmn:incoming>
      <bpmn:outgoing>Flow_0rt2is8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="HF-SD-P060-ZP01-010" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="HF-SD-P060-ZP01-010" targetRef="HF-SD-P060-ZP01-020" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="HF-SD-P060-ZP01-020" targetRef="Gateway_030" />
    <bpmn:sequenceFlow id="Flow_5" name="否" sourceRef="Gateway_030" targetRef="HF-SD-P060-ZP01-050">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isInterCompanyDirectShipment == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" name="是" sourceRef="Gateway_030" targetRef="HF-SD-P060-ZP01-040">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isInterCompanyDirectShipment == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="HF-SD-P060-ZP01-040" targetRef="HF-SD-P060-ZP01-050" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="HF-SD-P060-ZP01-050" targetRef="HF-SD-P060-ZP01-060" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="HF-SD-P060-ZP01-060" targetRef="Gateway_070" />
    <bpmn:sequenceFlow id="Flow_9" name="是" sourceRef="Gateway_070" targetRef="HF-SD-P060-ZP01-090">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${inventorySufficient == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" name="否" sourceRef="Gateway_070" targetRef="HF-SD-P060-ZP01-080">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${inventorySufficient == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Return" sourceRef="HF-SD-P060-ZP01-080" targetRef="HF-SD-P060-ZP01-090" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="HF-SD-P060-ZP01-090" targetRef="Gateway_100" />
    <bpmn:sequenceFlow id="Flow_12" name="是" sourceRef="Gateway_100" targetRef="HF-SD-P060-ZP01-110">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isInterCompanyOutbound == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="否" sourceRef="Gateway_100" targetRef="HF-SD-P060-ZP01-130">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isInterCompanyOutbound == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="HF-SD-P060-ZP01-110" targetRef="HF-SD-P060-ZP01-120" />
    <bpmn:sequenceFlow id="Flow_0sqc1k7" sourceRef="HF-SD-P060-ZP01-120" targetRef="HF-SD-P060-ZP01-130" />
    <bpmn:sequenceFlow id="Flow_1i8f5jg" sourceRef="HF-SD-P060-ZP01-130" targetRef="HF-SD-P060-ZP01-140" />
    <bpmn:sequenceFlow id="Flow_0rt2is8" sourceRef="HF-SD-P060-ZP01-150" targetRef="HF-SD-P060-ZP01-170" />
    <bpmn:sequenceFlow id="Flow_1fw1irj" sourceRef="HF-SD-P060-ZP01-160" targetRef="HF-SD-P060-ZP01-170" />
    <bpmn:sequenceFlow id="Flow_0yw3ow7" name="否" sourceRef="Gateway_0gdjt3o" targetRef="HF-SD-P060-ZP01-170">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0a2a7cj" sourceRef="HF-SD-P060-ZP01-170" targetRef="Activity_0nznf4h" />
    <bpmn:sequenceFlow id="Flow_0ewgnn8" sourceRef="Activity_0nznf4h" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_1aa44zr" sourceRef="HF-SD-P060-ZP01-060" targetRef="HF-SD-P060-ZP01-160" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="HF-SD-P060-ZP01-140" targetRef="Gateway_0gdjt3o" />
    <bpmn:sequenceFlow id="Flow_1gu6qqg" name="是" sourceRef="Gateway_0gdjt3o" targetRef="HF-SD-P060-ZP01-150">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1roupqo">
