<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="MM_Process_Definition" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.0.0">
  <bpmn:collaboration id="Collaboration_MM">
    <bpmn:participant id="Participant_MM" name="MM物料管理流程" processRef="MM_Material_Management_Process" />
  </bpmn:collaboration>
  <bpmn:process id="MM_Material_Management_Process" name="物料管理流程" isExecutable="true">
    <bpmn:documentation>物料管理流程：从接收评审通过订单到领料完成的流程</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_14bvntw">
      <bpmn:lane id="Lane_0yp2e9k" name="物控岗">
        <bpmn:flowNodeRef>EndEvent_MaterialPickingComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_ReceiveApprovedOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseProductionOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MaterialMasterMaintenance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrintPickList</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_19qwd2a" name="生产部门">
        <bpmn:flowNodeRef>Activity_0wgx9bm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="Activity_0wgx9bm" targetRef="EndEvent_MaterialPickingComplete" />
    <bpmn:sequenceFlow id="Flow_1jbi42p" sourceRef="Task_PrintPickList" targetRef="Activity_0wgx9bm" />
    <bpmn:endEvent id="EndEvent_MaterialPickingComplete" name="领料完成">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1o0imf7" sourceRef="StartEvent_ReceiveApprovedOrder" targetRef="Task_ReleaseProductionOrder" />
    <bpmn:userTask id="Activity_0wgx9bm" name="领料">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1jbi42p</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_ReceiveApprovedOrder" name="接收评审通过订单">
      <bpmn:outgoing>Flow_1o0imf7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_00px8tk" sourceRef="Task_ReleaseProductionOrder" targetRef="Task_MaterialMasterMaintenance" />
    <bpmn:sequenceFlow id="Flow_1a13jik" sourceRef="Task_MaterialMasterMaintenance" targetRef="Task_PrintPickList" />
    <bpmn:userTask id="Task_ReleaseProductionOrder" name="生产订单下达">
      <bpmn:documentation>角色：计划部
行动：下达生产订单</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="planning_department" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1o0imf7</bpmn:incoming>
      <bpmn:outgoing>Flow_00px8tk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MaterialMasterMaintenance" name="物料主数据维护">
      <bpmn:documentation>角色：物料管理部
行动：维护物料主数据信息</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="material_management" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_00px8tk</bpmn:incoming>
      <bpmn:outgoing>Flow_1a13jik</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PrintPickList" name="发料">
      <bpmn:documentation>角色：仓库管理
行动：打印领料单</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="warehouse_management" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1a13jik</bpmn:incoming>
      <bpmn:outgoing>Flow_1jbi42p</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BpmnDiagram_MM">
    <bpmndi:BPMNPlane id="BpmnPlane_MM" bpmnElement="Collaboration_MM">
      <bpmndi:BPMNShape id="Participant_MM_di" bpmnElement="Participant_MM" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="920" height="390" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0yp2e9k_di" bpmnElement="Lane_0yp2e9k" isHorizontal="true">
        <dc:Bounds x="180" y="80" width="890" height="250" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_19qwd2a_di" bpmnElement="Lane_19qwd2a" isHorizontal="true">
        <dc:Bounds x="180" y="330" width="890" height="140" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_MaterialPickingComplete_di" bpmnElement="EndEvent_MaterialPickingComplete">
        <dc:Bounds x="952" y="170" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="948" y="213" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0wgx9bm_di" bpmnElement="Activity_0wgx9bm">
        <dc:Bounds x="750" y="360" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_ReceiveApprovedOrder_di" bpmnElement="StartEvent_ReceiveApprovedOrder">
        <dc:Bounds x="240" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="214" y="225" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReleaseProductionOrder_di" bpmnElement="Task_ReleaseProductionOrder">
        <dc:Bounds x="330" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MaterialMasterMaintenance_di" bpmnElement="Task_MaterialMasterMaintenance">
        <dc:Bounds x="490" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrintPickList_di" bpmnElement="Task_PrintPickList">
        <dc:Bounds x="650" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_To_End_di" bpmnElement="Flow_To_End">
        <di:waypoint x="850" y="400" />
        <di:waypoint x="911" y="400" />
        <di:waypoint x="911" y="188" />
        <di:waypoint x="952" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1jbi42p_di" bpmnElement="Flow_1jbi42p">
        <di:waypoint x="750" y="200" />
        <di:waypoint x="800" y="200" />
        <di:waypoint x="800" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1o0imf7_di" bpmnElement="Flow_1o0imf7">
        <di:waypoint x="276" y="200" />
        <di:waypoint x="330" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_00px8tk_di" bpmnElement="Flow_00px8tk">
        <di:waypoint x="430" y="200" />
        <di:waypoint x="490" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1a13jik_di" bpmnElement="Flow_1a13jik">
        <di:waypoint x="590" y="200" />
        <di:waypoint x="650" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
