    <task id="Activity_0sho9cm" name="01 报价需求">
      <documentation>客户方发起需求，客户需求会提供相关资料，资料包括：
1、制造要求 (spec.)：其中记录客户对于PCB的制造特别要求，如：板材、油墨和特殊工艺要求等，该资料一般情况下格式不统一，可能是：PDF、Word、Excel和纯文本等
2、PCB图纸（Gerber文件）：用EDA软件绘制的PCB板图，Gerber文件需要使用专业EDA、CAM软件打开，同时也可以用文本编辑器打开，有一定的规范格式</documentation>
      <incoming>Flow_0dg2tgf</incoming>
      <outgoing>Flow_1azgdkz</outgoing>
    </task>
    <task id="Activity_0devq21" name="09 客户创建PO">
      <documentation>客户接受报价，客户创建正式PO</documentation>
      <incoming>Flow_0awenn0</incoming>
      <outgoing>Flow_1klvtrb</outgoing>
    </task>
    <task id="Activity_0jl1jc8" name="22 客户确认收货">
      <incoming>Flow_1klvtrb</incoming>
      <outgoing>Flow_00furhg</outgoing>
    </task>
    <endEvent id="Event_0fn8fp3">
      <incoming>Flow_00furhg</incoming>
    </endEvent>
    <sequenceFlow id="Flow_0dg2tgf" sourceRef="Event_0jzxr5t" targetRef="Activity_0sho9cm" />
    <sequenceFlow id="Flow_1azgdkz" sourceRef="Activity_0sho9cm" targetRef="Activity_1tytk9f" />
