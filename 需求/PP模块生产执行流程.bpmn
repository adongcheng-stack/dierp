      <bpmndi:BPMNShape id="Gateway_WorkOrderComplete_di" bpmnElement="Gateway_WorkOrderComplete" isMarkerVisible="true">
        <dc:Bounds x="1092" y="163" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1081" y="213" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CloseProductionOrder_di" bpmnElement="Task_CloseProductionOrder">
        <dc:Bounds x="1190" y="148" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ProductionOrderClosed_di" bpmnElement="EndEvent_ProductionOrderClosed">
        <dc:Bounds x="1340" y="170" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1314" y="213" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_To_MPS_di" bpmnElement="Flow_To_MPS">
        <di:waypoint x="276" y="188" />
        <di:waypoint x="340" y="188" />
      </bpmndi:BPMNEdge>
