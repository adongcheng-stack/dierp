<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="PP_Process_Definition" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.0.0">
  <bpmn:collaboration id="Collaboration_0ax8ck5">
    <bpmn:participant id="Participant_1poabrl" name="PP生产计划流程" processRef="PP_Production_Planning_Process" />
    <bpmn:textAnnotation id="TextAnnotation_0g647ix">
      <bpmn:text>对应：标准生产订单管理流程.bpmn
MVP暂不处理</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ijr8zc" associationDirection="None" sourceRef="Task_ReleaseProductionOrder" targetRef="TextAnnotation_0g647ix" />
    <bpmn:textAnnotation id="TextAnnotation_08kixje">
      <bpmn:text>HF_PP_P060 生产主计划流程.bpmn
MVP暂不处理，假设已经排好</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0f5a0s1" associationDirection="None" sourceRef="Task_MasterProductionSchedule" targetRef="TextAnnotation_08kixje" />
    <bpmn:textAnnotation id="TextAnnotation_1ifomzf">
      <bpmn:text>HF_PP_P200 生产订单关闭流程.bpmn
MVP暂不处理</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_04kuujg" associationDirection="None" sourceRef="Task_CloseProductionOrder" targetRef="TextAnnotation_1ifomzf" />
  </bpmn:collaboration>
  <bpmn:process id="PP_Production_Planning_Process" name="生产计划流程" isExecutable="true">
    <bpmn:documentation>生产计划流程：从评审通过的订单到生产订单关闭的完整流程</bpmn:documentation>
    <bpmn:dataObject id="DataObject_ProductionOrder" />
    <bpmn:dataObjectReference id="DataObjectReference_ProductionOrder" name="生产订单" dataObjectRef="DataObject_ProductionOrder" />
    <bpmn:dataObject id="DataObject_WorkOrder" />
    <bpmn:dataObjectReference id="DataObjectReference_WorkOrder" name="工单" dataObjectRef="DataObject_WorkOrder" />
    <bpmn:startEvent id="StartEvent_ReceiveApprovedOrder" name="接收ENG评审通过MI">
      <bpmn:outgoing>Flow_To_MPS</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_MasterProductionSchedule" name="主生产计划排程">
      <bpmn:documentation>角色：计划部
行动：根据订单要求和产能情况，进行主生产计划排程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="planning_department" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_MPS</bpmn:incoming>
      <bpmn:outgoing>Flow_To_ReleaseProductionOrder</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReleaseProductionOrder" name="生产订单下达">
      <bpmn:documentation>角色：计划部
行动：下达生产订单</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="planning_department" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_ReleaseProductionOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_To_GenerateWorkOrder</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_GenerateWorkOrder" name="生成工单">
      <bpmn:documentation>角色：系统
行动：根据生产订单和工艺路线生成工单</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-work-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_GenerateWorkOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_To_AssignWorkCenter</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_AssignWorkCenter" name="分配工作中心">
      <bpmn:documentation>角色：计划部
行动：为工单分配工作中心</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="planning_department" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_AssignWorkCenter</bpmn:incoming>
      <bpmn:outgoing>Flow_To_OperationReport</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_OperationReport" name="工序报工">
      <bpmn:documentation>角色：各工序产线工人
行动：各工序开始记录，各工序完成后半成品过数
功能：各工序开始时确认，各工序记录完成数量</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="production_workers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_OperationReport</bpmn:incoming>
      <bpmn:incoming>Flow_WorkOrderInProgress</bpmn:incoming>
      <bpmn:outgoing>Flow_To_CheckWorkOrderStatus</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_WorkOrderComplete" name="工单是否完成?">
      <bpmn:incoming>Flow_To_CheckWorkOrderStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_WorkOrderInProgress</bpmn:outgoing>
      <bpmn:outgoing>Flow_WorkOrderCompleted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CloseProductionOrder" name="生产订单关闭">
      <bpmn:documentation>角色：计划部
行动：确认工单全部完成，关闭生产订单</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="planning_department" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_WorkOrderCompleted</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_ProductionOrderClosed" name="生产订单关闭完成">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_To_MPS" sourceRef="StartEvent_ReceiveApprovedOrder" targetRef="Task_MasterProductionSchedule" />
    <bpmn:sequenceFlow id="Flow_To_ReleaseProductionOrder" sourceRef="Task_MasterProductionSchedule" targetRef="Task_ReleaseProductionOrder" />
    <bpmn:sequenceFlow id="Flow_To_GenerateWorkOrder" sourceRef="Task_ReleaseProductionOrder" targetRef="Task_GenerateWorkOrder" />
    <bpmn:sequenceFlow id="Flow_To_AssignWorkCenter" sourceRef="Task_GenerateWorkOrder" targetRef="Task_AssignWorkCenter" />
    <bpmn:sequenceFlow id="Flow_To_OperationReport" sourceRef="Task_AssignWorkCenter" targetRef="Task_OperationReport" />
    <bpmn:sequenceFlow id="Flow_WorkOrderInProgress" name="否" sourceRef="Gateway_WorkOrderComplete" targetRef="Task_OperationReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${workOrderCompleted == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_To_CheckWorkOrderStatus" sourceRef="Task_OperationReport" targetRef="Gateway_WorkOrderComplete" />
    <bpmn:sequenceFlow id="Flow_WorkOrderCompleted" name="是" sourceRef="Gateway_WorkOrderComplete" targetRef="Task_CloseProductionOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${workOrderCompleted == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="Task_CloseProductionOrder" targetRef="EndEvent_ProductionOrderClosed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BpmnDiagram_PP">
    <bpmndi:BPMNPlane id="BpmnPlane_PP" bpmnElement="Collaboration_0ax8ck5">
      <bpmndi:BPMNShape id="Participant_1poabrl_di" bpmnElement="Participant_1poabrl" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1260" height="250" />
