              "type": "input_field",
              "label": "库位信息",
              "input_type": "text",
              "current_value": "A-01-01, A-02-03, B-01-05"
            }
          ]
        }
      ]
    }
  ],
  "button_group": {
    "buttons": [
      {
        "type": "success_button",
        "text": "保存草稿",
        "action": "save_draft",
        "class": "btn-success"
      },
      {
        "type": "primary_button",
        "text": "提交审核",
        "action": "submit_for_review",
        "class": "btn-primary"
      },
      {
        "type": "secondary_button",
        "text": "打印领料单",
        "action": "print_picking_list",
        "class": "btn-secondary"
      },
      {
        "type": "warning_button",
        "text": "生成缺料单",
        "action": "generate_shortage_list",
        "class": "btn-warning"
      },
      {
        "type": "secondary_button",
        "text": "取消",
        "action": "cancel",
        "class": "btn-secondary"
      }
    ],
    "style": "btn-group"
  },
  "timestamp_info": {
    "text": "领料单创建时间: 2025-12-04 09:15:33 | 创建人: 张三 (生产部)",
    "style": "timestamp"
  },
  "ui_styles": {
    "container_style": "ui-container",
    "header_style": "ui-header",
    "body_style": "ui-body",
    "form_group_style": "form-group",
    "form_control_style": "form-control",
    "form_row_style": "form-row",
    "select_dropdown_style": "select-dropdown",
    "table_container_style": "table-container",
    "data_table_style": "data-table"
  },
  "function_features": [
    "基于生产订单自动生成领料需求",
    "实时显示物料库存和安全库存",
    "库存不足时自动预警",
    "支持部分领料和缺料单生成"
  ],
  "interactive_features": [
    {
      "name": "库存检查",
      "description": "输入实际发放数量时自动检查库存限制并更新差异状态",
      "trigger": "input_number_change"
    },
    {
      "name": "保存功能",
      "description": "保存草稿时更新最后保存时间戳",
      "trigger": "save_button_click"
    }
  ],
  "metadata": {
    "extraction_date": "2025-12-06",
    "source_file": "某某ERP系统MVP界面需求1.3 - 生产领料.html",
    "version": "1.3",
    "interface_purpose": "用于仓库管理员处理生产订单的物料发放"
  }
