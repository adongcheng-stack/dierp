        {
          "type": "form_row",
          "elements": [
            {
              "type": "input_field",
              "label": "领料单号",
              "input_type": "text",
              "current_value": "LL20251204001",
              "readonly": true
            },
            {
              "type": "dropdown",
              "label": "生产订单",
              "options": [
                "PO20251204001 - HS1004ENIGAB01 (100PCS)",
                "PO20251204002 - HS3008GOLDCI02 (50PCS)"
              ],
              "current_value": "PO20251204001 - HS1004ENIGAB01 (100PCS)"
            }
          ]
        },
        {
          "type": "form_row",
          "elements": [
            {
              "type": "input_field",
              "label": "领料部门",
              "input_type": "text",
              "current_value": "生产部",
