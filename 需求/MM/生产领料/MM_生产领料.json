              "type": "input_number",
              "value": 5,
              "min": 0,
              "max": 15,
              "editable": true,
              "style": "background-color: #fff3cd"
            },
            {
              "type": "warning_text",
              "text": "库存不足",
              "style": "color: #e74c3c"
            }
