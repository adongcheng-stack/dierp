              "editable": true
            },
            {
              "type": "status_text",
              "text": "0",
              "style": "color: green"
            }
          ],
          "row_style": "normal"
        },
        {
          "row_index": 3,
          "cells": [
            "3",
            "MAT-PP-2116",
            "半固化片2116",
            "2116",
            "张",
            "30",
            "87",
            "40",
            {
              "type": "input_number",
              "value": 30,
              "min": 0,
              "max": 87,
              "editable": true
            },
            {
              "type": "status_text",
              "text": "0",
              "style": "color: green"
