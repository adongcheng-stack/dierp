<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.0.0">
  <bpmn:collaboration id="Collaboration_04iv0x6">
    <bpmn:participant id="Participant_1ozjym9" name="生产订单领料流程" processRef="HF_MM_P140" />
  </bpmn:collaboration>
  <bpmn:process id="HF_MM_P140" name="生产订单领料流程(基板)" isExecutable="true">
    <bpmn:documentation>适用范围: 生产订单领料流程(基板)</bpmn:documentation>
    <bpmn:extensionElements />
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Production" name="生产部门">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_HF_PP_P100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_MM_P140-ZP01-080</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_MM_P140-ZP01-020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_MM_P140-ZP01-060</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SCM" name="供应链管理部">
        <bpmn:flowNodeRef>Gateway_030</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_MM_P140-ZP01-050</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_050</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_MM_P140-ZP01-030</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_MM_P140-ZP01-070</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_MM_P140-ZP01-040</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="开始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="SubProcess_HF_PP_P100" name="标准生产订单流程">
      <bpmn:documentation>任务类型: 子流程
操作: 接标准生产订单流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="HF_PP_P100" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_030" name="是否超领?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="HF_MM_P140-ZP01-050" name="050: 相关人员审核">
      <bpmn:documentation>任务类型: 用户任务
系统: OA系统
操作: PP模块提供相关数据支持进行审核。OA根据超标幅度转至相应岗位审核。1. 超5%物控岗审核, 2. 超5%~10%供应链总监审核 3.10%以上由工艺总监审核</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="userTask" />
        <zeebe:assignmentDefinition candidateGroups="${approvalGroup}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_050" name="相关人员审核是否通过?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_Return</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="HF_MM_P140-ZP01-080" name="080: 生产部门签收出库单收料">
      <bpmn:documentation>任务类型: 用户任务
输入文件: 领料单/出库单
操作: 生产部门签收出库单及收料</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="userTask" />
        <zeebe:assignmentDefinition assignee="${productionAssignee}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="结束">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="HF_MM_P140-ZP01-020" name="020: 生产部门提领料申请">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
操作: 生产部门提领料申请</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_MM_P140-ZP01-030" name="030: 判定是否是超领">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
操作: 系统根据PP模块物料清单(BOM)与MRP据清单判定是否超领</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_MM_P140-ZP01-060" name="060: 打印领料单">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
输出文件: 领料单
操作: 打印领料单</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1ej69ke">
        <bpmn:targetRef>HF_MM_P140-ZP01-DO01</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="HF_MM_P140-ZP01-070" name="070: 帐务员过帐出库">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
输入文件: 领料单
输出文件: 出库单
操作: 帐务员根据领料单进行过账出库</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="HF_MM_P140-ZP01-040" name="040: 在OA中做超领审核">
      <bpmn:documentation>任务类型: 用户任务
系统: OA系统
操作: 在OA系统做相应超领审核</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:dataObjectReference id="HF_MM_P140-ZP01-DO01" name="领料单" dataObjectRef="DataObject_1ysgbll" />
    <bpmn:dataObject id="DataObject_1ysgbll" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="SubProcess_HF_PP_P100" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SubProcess_HF_PP_P100" targetRef="HF_MM_P140-ZP01-020" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="HF_MM_P140-ZP01-030" targetRef="Gateway_030" />
    <bpmn:sequenceFlow id="Flow_5" name="是" sourceRef="Gateway_030" targetRef="HF_MM_P140-ZP01-040">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isOverRequisition == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="否" sourceRef="Gateway_030" targetRef="HF_MM_P140-ZP01-050">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isOverRequisition == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="HF_MM_P140-ZP01-040" targetRef="HF_MM_P140-ZP01-050" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="HF_MM_P140-ZP01-050" targetRef="Gateway_050" />
    <bpmn:sequenceFlow id="Flow_8" name="是" sourceRef="Gateway_050" targetRef="HF_MM_P140-ZP01-060">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalPassed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Return" name="否" sourceRef="Gateway_050" targetRef="HF_MM_P140-ZP01-020">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalPassed == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="HF_MM_P140-ZP01-070" targetRef="HF_MM_P140-ZP01-080" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="HF_MM_P140-ZP01-080" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="HF_MM_P140-ZP01-020" targetRef="HF_MM_P140-ZP01-030" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="HF_MM_P140-ZP01-060" targetRef="HF_MM_P140-ZP01-070" />
  </bpmn:process>
