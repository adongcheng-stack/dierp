{
  "system": "某某ERP系统",
  "version": "MVP 1.3",
  "module": "MM模块 - 库存查询",
  "interface_elements": {
    "查询表单": {
      "物料编码": {
        "type": "text_input",
        "placeholder": "输入物料编码",
        "required": false,
        "width": "full"
      },
      "物料名称": {
        "type": "text_input",
        "placeholder": "输入物料名称",
        "required": false,
        "width": "full"
      },
      "仓库": {
        "type": "dropdown_select",
        "options": ["所有仓库", "原料仓", "辅料仓", "化工仓", "成品仓"],
        "default": "所有仓库",
        "width": "full"
      },
      "库存类型": {
        "type": "dropdown_select",
        "options": ["所有类型", "原材料", "半成品", "成品"],
        "default": "所有类型",
        "width": "full"
      }
    },
    "数据表格": {
      "columns": ["物料编码", "物料名称", "规格", "仓库", "库存", "单位"],
      "row_highlighting": "hover_effect",
      "low_stock_indicator": {
        "enabled": true,
        "threshold_field": "库存",
        "warning_color": "#e74c3c"
      }
    },
    "操作按钮": [
      {
        "id": "refresh",
        "label": "刷新",
        "type": "primary",
        "color": "#3498db"
      },
      {
        "id": "export",
        "label": "导出",
        "type": "success",
        "color": "#27ae60"
      },
      {
        "id": "print",
        "label": "打印",
        "type": "secondary",
        "color": "#7f8c8d"
      },
      {
        "id": "adjust_stock",
        "label": "库存调整",
        "type": "secondary",
        "color": "#7f8c8d"
      }
    ],
    "信息显示": {
      "total_items": {
        "label": "总计",
        "format": "{count}项物料"
      },
      "low_stock_warning": {
        "enabled": true,
        "format": "⚠ {物料编码}库存低于安全库存（{当前库存} < {安全库存}）",
        "style": {
          "color": "#e74c3c",
          "background": "#fff3cd",
          "padding": "10px",
          "border_radius": "4px"
        }
      }
    }
  },
  "sample_data": [
    {
      "物料编码": "MAT-FR4-1.2",
      "物料名称": "FR4板材1.2mm",
      "规格": "FR4 TG130",
      "仓库": "原料仓",
      "库存": 125,
      "单位": "张",
      "安全库存": 50
    },
    {
      "物料编码": "MAT-CU-1OZ",
      "物料名称": "铜箔1oz",
      "规格": "电解铜箔",
      "仓库": "原料仓",
      "库存": 42,
      "单位": "卷",
      "安全库存": 30
    },
    {
      "物料编码": "MAT-PP-2116",
      "物料名称": "半固化片2116",
      "规格": "2116",
      "仓库": "原料仓",
      "库存": 87,
      "单位": "张",
      "安全库存": 50
    },
    {
      "物料编码": "MAT-DRYFILM",
      "物料名称": "干膜",
      "规格": "25μm",
      "仓库": "辅料仓",
      "库存": 15,
      "单位": "卷",
      "安全库存": 20,
      "low_stock": true
    }
  ],
  "ui_specifications": {
    "layout": {
      "form_layout": "two_column_responsive",
      "table_scrollable": true
    },
    "styles": {
      "primary_color": "#3498db",
      "secondary_color": "#7f8c8d",
      "success_color": "#27ae60",
      "warning_color": "#e74c3c",
      "table_header_bg": "#f8f9fa",
      "row_hover_bg": "#f8f9fa"
    },
    "responsive": true
  }
}