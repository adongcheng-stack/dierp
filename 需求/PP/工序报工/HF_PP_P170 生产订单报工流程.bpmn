<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.0.0">
  <bpmn:collaboration id="Collaboration_1ru0py1">
    <bpmn:participant id="Participant_1a7bumh" name="生产订单报工" processRef="HF_PP_P170" />
  </bpmn:collaboration>
  <bpmn:process id="HF_PP_P170" name="生产订单报工流程" isExecutable="true">
    <bpmn:documentation>适用范围: 本流程适用于生产工序完工后的过数与报工业务</bpmn:documentation>
    <bpmn:extensionElements />
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_WorkshopForeman" name="车间领班/过数员">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P170-ZP01-010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P170-ZP01-020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P170-ZP01-030</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_040</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_ErrorHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="开始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="HF_PP_P170-ZP01-010" name="010: LOT卡过数">
      <bpmn:documentation>任务类型: 用户任务
系统: 生产执行系统
操作: 车间领班或过数员在制造执行系统中对LOT卡进行过数</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="userTask" />
        <zeebe:assignmentDefinition assignee="${workshopForemanAssignee}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="HF_PP_P170-ZP01-020" name="020: 生产订单报工 (自动)">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: CO11N
操作: 制造执行系统过数时把过数信息(数量、时间等)同步到SAP，SAP根据过数信息自动完成报工</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="HF_PP_P170-ZP01-030" name="030: 生产订单反冲扣料 (自动)">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: CO11N
操作: 生产订单报工时需要反冲扣料的物料在报工时会自动进行反冲扣料</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_040" name="是否存在反冲错误?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SubProcess_ErrorHandling" name="反冲错误处理流程">
      <bpmn:documentation>任务类型: 子流程
操作: 转接反冲错误处理流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="ErrorHandling" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_2" name="结束（错误处理后）">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="HF_PP_P170-ZP01-010" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="HF_PP_P170-ZP01-010" targetRef="HF_PP_P170-ZP01-020" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="HF_PP_P170-ZP01-020" targetRef="HF_PP_P170-ZP01-030" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="HF_PP_P170-ZP01-030" targetRef="Gateway_040" />
    <bpmn:sequenceFlow id="Flow_5" name="是" sourceRef="Gateway_040" targetRef="SubProcess_ErrorHandling">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasBackflushError == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="否" sourceRef="Gateway_040" targetRef="EndEvent_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasBackflushError == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="SubProcess_ErrorHandling" targetRef="EndEvent_2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1ru0py1">
      <bpmndi:BPMNShape id="Participant_1a7bumh_di" bpmnElement="Participant_1a7bumh" isHorizontal="true">
        <dc:Bounds x="160" y="50" width="1110" height="300" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_WorkshopForeman_di" bpmnElement="Lane_WorkshopForeman" isHorizontal="true">
        <dc:Bounds x="190" y="50" width="1080" height="300" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="282" y="179" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="289" y="222" width="23" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_Task_010" bpmnElement="HF_PP_P170-ZP01-010">
        <dc:Bounds x="370" y="157" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_Task_020" bpmnElement="HF_PP_P170-ZP01-020">
        <dc:Bounds x="530" y="157" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_Task_030" bpmnElement="HF_PP_P170-ZP01-030">
        <dc:Bounds x="690" y="157" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_Gateway_040" bpmnElement="Gateway_040" isMarkerVisible="true">
        <dc:Bounds x="845" y="172" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="825" y="135" width="89" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_SubProcess_ErrorHandling" bpmnElement="SubProcess_ErrorHandling">
        <dc:Bounds x="960" y="157" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_EndEvent_2" bpmnElement="EndEvent_2">
        <dc:Bounds x="1162" y="179" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1081" y="166" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="318" y="197" />
        <di:waypoint x="370" y="197" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="470" y="197" />
        <di:waypoint x="530" y="197" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="630" y="197" />
        <di:waypoint x="690" y="197" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="790" y="197" />
        <di:waypoint x="845" y="197" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="895" y="197" />
        <di:waypoint x="960" y="197" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="922" y="179" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="870" y="222" />
        <di:waypoint x="870" y="300" />
        <di:waypoint x="1180" y="300" />
        <di:waypoint x="1180" y="215" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="891" y="284" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1060" y="197" />
        <di:waypoint x="1162" y="197" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>