<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.0.0">
  <bpmn:collaboration id="Collaboration_1je0wuf">
    <bpmn:participant id="Participant_1ctwvob" name="生产主计划流程" processRef="HF_PP_P060" />
  </bpmn:collaboration>
  <bpmn:process id="HF_PP_P060" name="合同评审和生产主计划流程" isExecutable="true">
    <bpmn:documentation>适用范围: 适用于合同评审、生产主计划流程</bpmn:documentation>
    <bpmn:extensionElements />
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Planning" name="计划组">
        <bpmn:flowNodeRef>SubProcess_MRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_080</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P060-ZP01-020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P060-ZP01-040</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P060-ZP01-050</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P060-ZP01-060</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P060-ZP01-070</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Engineering" name="工程部">
        <bpmn:flowNodeRef>HF_PP_P060-ZP01-030</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Marketing" name="市场部">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_HF-SD-P050</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_090</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P060-ZP01-010</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="开始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="SubProcess_HF-SD-P050" name="销售订单下达流程">
      <bpmn:documentation>任务类型: 子流程
操作: 承接销售订单下达流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="HF-SD-P050" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="SubProcess_MRP" name="物料需求计划流程">
      <bpmn:documentation>任务类型: 子流程
操作: 转接物料需求计划流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="MRP" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_080" name="是否满足市场交期?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_090" name="市场确认交期是否可接受?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_1" name="结束（满足交期）">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="HF_PP_P060-ZP01-010" name="010: 发起合同评审">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: ZPPX XX
操作: 市场部发起合同评审</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_PP_P060-ZP01-020" name="020: 订单分配">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: ZPPX XX
输入输出文件: 订单分配规则文档
操作: 根据工厂产能和产品特性，对销售订单分配生产工厂</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_PP_P060-ZP01-030" name="030: 工程部评审">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: ZPPX XX
操作: 工程部对生产版本进行评审，确认BOM、工艺路线等数据无误</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_PP_P060-ZP01-040" name="040: 确认宽投率">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: ZPPX XX
输入输出文件: 宽投率文档
操作: 系统根据规则自动得出建议的宽投率，计划组确认宽投率</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_PP_P060-ZP01-050" name="050: 生成生产订单(MO)及物料需求">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: ZPPX XX
操作: 系统生成生产订单及物料需求</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_PP_P060-ZP01-060" name="060: 产能评估">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: ZPPX XX
输入输出文件: 产能分配报表
操作: 计划组根据工厂当前负荷进行产能评估，确定投产日期</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_PP_P060-ZP01-070" name="070: 确认生产完工日期">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: ZPPX XX
操作: 计划组根据物料齐套情况和产能状况确定生产完工日期</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="SubProcess_HF-SD-P050" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SubProcess_HF-SD-P050" targetRef="HF_PP_P060-ZP01-010" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="HF_PP_P060-ZP01-050" targetRef="SubProcess_MRP" />
    <bpmn:sequenceFlow id="Flow_14" name="否" sourceRef="Gateway_090" targetRef="SubProcess_MRP">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${newDeliveryDateAccepted == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="SubProcess_MRP" targetRef="HF_PP_P060-ZP01-060" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="HF_PP_P060-ZP01-070" targetRef="Gateway_080" />
    <bpmn:sequenceFlow id="Flow_11" name="是" sourceRef="Gateway_080" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${meetsMarketDeliveryDate == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="否" sourceRef="Gateway_080" targetRef="Gateway_090">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${meetsMarketDeliveryDate == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="是，结束（接受新交期" sourceRef="Gateway_090" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${newDeliveryDateAccepted == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="HF_PP_P060-ZP01-010" targetRef="HF_PP_P060-ZP01-020" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="HF_PP_P060-ZP01-020" targetRef="HF_PP_P060-ZP01-030" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="HF_PP_P060-ZP01-030" targetRef="HF_PP_P060-ZP01-040" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="HF_PP_P060-ZP01-040" targetRef="HF_PP_P060-ZP01-050" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="HF_PP_P060-ZP01-060" targetRef="HF_PP_P060-ZP01-070" />
  </bpmn:process>
