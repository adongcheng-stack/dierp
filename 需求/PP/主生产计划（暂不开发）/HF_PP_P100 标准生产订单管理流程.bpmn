  <bpmn:collaboration id="Collaboration_1azqglx">
    <bpmn:participant id="Participant_045gkaz" name="标准生产订单管理" processRef="HF_PP_P100" />
  </bpmn:collaboration>
  <bpmn:process id="HF_PP_P100" name="标准生产订单管理流程" isExecutable="true">
    <bpmn:documentation>适用范围: 本流程适用于标准生产订单的管理业务(如小批量量产订单或直接量产订单)</bpmn:documentation>
    <bpmn:extensionElements />
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PMC_PPC" name="PMC/PPC">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_HF_PP_P060</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P100-ZP01-030</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_040</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_080</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_LineSideTransfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_HF_MM_P140</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_ShopFloorPlanning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_090</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Replenishment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_HF_PP_P170</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_HF-SD-P070</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P100-ZP01-010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P100-ZP01-020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P100-ZP01-050</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P100-ZP01-070</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P100-ZP01-060</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="开始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="SubProcess_HF_PP_P060" name="生产主计划流程">
      <bpmn:documentation>任务类型: 子流程
操作: 承接生产主计划流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="HF_PP_P060" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="HF_PP_P100-ZP01-030" name="030: 生产订单齐套性检查">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: CO02, MB52
责任部门: PPC
操作: PPC人员检查生产订单BOM物料的库存信息，并将检查结果反馈到PMC</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_040" name="是否需要物料替代?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_080" name="是否为反冲物料?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SubProcess_LineSideTransfer" name="线边仓调拨流程">
      <bpmn:documentation>任务类型: 子流程
操作: 承接线边仓调拨流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="LineSideTransfer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="SubProcess_HF_MM_P140" name="生产订单领料流程">
      <bpmn:documentation>任务类型: 子流程
操作: 承接生产订单领料流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="HF_MM_P140" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="SubProcess_ShopFloorPlanning" name="车间生产计划流程">
      <bpmn:documentation>任务类型: 子流程
操作: 承接车间生产计划流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="ShopFloorPlanning" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_090" name="是否需要补投?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SubProcess_Replenishment" name="生产补投流程">
      <bpmn:documentation>任务类型: 子流程
操作: 承接生产补投流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Replenishment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="SubProcess_HF_PP_P170" name="生产订单报工流程">
      <bpmn:documentation>任务类型: 子流程
操作: 转接生产报工流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="HF_PP_P170" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="SubProcess_HF-SD-P070" name="生产订单收货流程">
      <bpmn:documentation>任务类型: 子流程
操作: 转接生产订单收货流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="HF-SD-P070" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_1" name="结束">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="HF_PP_P100-ZP01-010" name="010: 查看标准生产订单清单">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: COOIS
操作: 查看标准生产订单清单</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_PP_P100-ZP01-020" name="020: 制定投料计划">
      <bpmn:documentation>任务类型: 用户任务
责任部门: PPC
时限: 2小时
操作: PPC针对生产订单制定投料计划</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_PP_P100-ZP01-050" name="050: 物料替代">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: CO02
责任部门: PMC
操作: PMC根据物料替代规范确定生产订单BOM</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_PP_P100-ZP01-070" name="070: 生产订单下达">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: CO02, COHV
责任部门: PPC
操作: PPC确认物料齐套，下达生产订单，生产领料，执行生产</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_PP_P100-ZP01-060" name="060: 物料可用性检查">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
责任部门: PPC
操作: PPC执行物料可用性检查，查看生产订单所需物料的库存是否满足需求，如有缺料从系统导出缺料清单后由PMC处理。齐套性检查: BOM物料和特殊物料有库存和PO到料日期
输出文件: 缺料清单</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="SubProcess_HF_PP_P060" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SubProcess_HF_PP_P060" targetRef="HF_PP_P100-ZP01-010" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="HF_PP_P100-ZP01-020" targetRef="HF_PP_P100-ZP01-030" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="HF_PP_P100-ZP01-030" targetRef="Gateway_040" />
    <bpmn:sequenceFlow id="Flow_6" name="是" sourceRef="Gateway_040" targetRef="HF_PP_P100-ZP01-050">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${materialSubstitutionRequired == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" name="否" sourceRef="Gateway_040" targetRef="HF_PP_P100-ZP01-060">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${materialSubstitutionRequired == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="HF_PP_P100-ZP01-070" targetRef="Gateway_080" />
    <bpmn:sequenceFlow id="Flow_11" name="是" sourceRef="Gateway_080" targetRef="SubProcess_LineSideTransfer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isBackflushMaterial == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="否" sourceRef="Gateway_080" targetRef="SubProcess_HF_MM_P140">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isBackflushMaterial == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="SubProcess_LineSideTransfer" targetRef="SubProcess_HF_MM_P140" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="SubProcess_HF_MM_P140" targetRef="SubProcess_ShopFloorPlanning" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="SubProcess_ShopFloorPlanning" targetRef="Gateway_090" />
    <bpmn:sequenceFlow id="Flow_16" name="是" sourceRef="Gateway_090" targetRef="SubProcess_Replenishment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${replenishmentRequired == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" name="否" sourceRef="Gateway_090" targetRef="SubProcess_HF_PP_P170">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${replenishmentRequired == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="SubProcess_Replenishment" targetRef="SubProcess_HF_PP_P170" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="SubProcess_HF_PP_P170" targetRef="SubProcess_HF-SD-P070" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="SubProcess_HF-SD-P070" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="HF_PP_P100-ZP01-010" targetRef="HF_PP_P100-ZP01-020" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="HF_PP_P100-ZP01-050" targetRef="HF_PP_P100-ZP01-060" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="HF_PP_P100-ZP01-060" targetRef="HF_PP_P100-ZP01-070" />
  </bpmn:process>
