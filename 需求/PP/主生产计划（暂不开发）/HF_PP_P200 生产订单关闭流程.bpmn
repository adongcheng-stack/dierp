<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.0.0">
  <bpmn:collaboration id="Collaboration_0g57pqx">
    <bpmn:participant id="Participant_1wbwmoj" name="生产订单关闭" processRef="HF_PP_P200" />
  </bpmn:collaboration>
  <bpmn:process id="HF_PP_P200" name="生产订单关闭流程" isExecutable="true">
    <bpmn:documentation>适用范围: 本流程适用于所有生产订单类型的关闭流程</bpmn:documentation>
    <bpmn:extensionElements />
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PMC_PPC" name="PMC/PPC">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P200-</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_HF-SD-P060</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_050</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P200-ZP01-060</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Settlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P200-ZP01-010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HF_PP_P200-ZP01-040</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Marketing" name="市场部">
        <bpmn:flowNodeRef>Gateway_030</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Replenishment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_BackflushError</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="开始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="HF_PP_P200-" name="生成车间计划流程">
      <bpmn:documentation>任务类型: 子流程
操作: 承接生成车间计划流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="ShopFloorPlanning" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_020" name="是否满足SO交货数量?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_030" name="是否需要补投?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SubProcess_Replenishment" name="生产补投流程">
      <bpmn:documentation>任务类型: 子流程
操作: 承接生产补投流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Replenishment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="SubProcess_HF-SD-P060" name="销售发货流程">
      <bpmn:documentation>任务类型: 子流程
操作: 转至销售发货流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="HF-SD-P060" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_050" name="是否存在反冲错误?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SubProcess_BackflushError" name="反冲错误处理流程">
      <bpmn:documentation>任务类型: 子流程
操作: 转接反冲错误处理流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="BackflushError" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="HF_PP_P200-ZP01-060" name="060: 生产订单技术性关闭">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: COHV, CO02
操作: PPC对生产订单进行技术性关闭
关闭条件:
1. 入库数量≥生产数量
2. 在线天数超过30天(第一笔发料日期作为起始日期)
3. 暂停的生产订单不在以上范围内
关单原则: 当投料数量=入仓数量+报废数量(只有良品和不良品两种状态)时，该订单才可以关闭</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="SubProcess_Settlement" name="生产订单结算流程">
      <bpmn:documentation>任务类型: 子流程
操作: 转至生产订单结算流程</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Settlement" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_1" name="结束">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="HF_PP_P200-ZP01-010" name="010: 生产订单执行情况确认">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: COOIS
输入输出文件: 生产订单查询报表
操作: PPC查询生产订单查询报表，检查生产订单报工、投料、退料、报废、入库情况</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HF_PP_P200-ZP01-040" name="040: 检查生产订单投料、报工情况">
      <bpmn:documentation>任务类型: 服务任务
系统: SAP系统
SAP操作: COOIS, C003
操作: PPC检查生产订单投料、报工情况，确保投料、报工业务数据正常、准确</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="HF_PP_P200-" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="SubProcess_Replenishment" targetRef="HF_PP_P200-" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="HF_PP_P200-" targetRef="HF_PP_P200-ZP01-010" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="HF_PP_P200-ZP01-010" targetRef="Gateway_020" />
    <bpmn:sequenceFlow id="Flow_4" name="是" sourceRef="Gateway_020" targetRef="SubProcess_HF-SD-P060">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${meetsSODeliveryQuantity == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" name="否" sourceRef="Gateway_020" targetRef="Gateway_030">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${meetsSODeliveryQuantity == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="是" sourceRef="Gateway_030" targetRef="SubProcess_Replenishment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${replenishmentNeeded == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" name="否" sourceRef="Gateway_030" targetRef="SubProcess_HF-SD-P060">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${replenishmentNeeded == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="SubProcess_HF-SD-P060" targetRef="HF_PP_P200-ZP01-040" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="HF_PP_P200-ZP01-040" targetRef="Gateway_050" />
    <bpmn:sequenceFlow id="Flow_11" name="是" sourceRef="Gateway_050" targetRef="SubProcess_BackflushError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasBackflushError == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="否" sourceRef="Gateway_050" targetRef="HF_PP_P200-ZP01-060">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasBackflushError == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="SubProcess_BackflushError" targetRef="HF_PP_P200-ZP01-060" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="HF_PP_P200-ZP01-060" targetRef="SubProcess_Settlement" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="SubProcess_Settlement" targetRef="EndEvent_1" />
  </bpmn:process>
